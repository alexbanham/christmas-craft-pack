{
	"chapter_group.6E6872417BE99080.title": "Christmas Craft"
	"chapter_group.227D82CAA2C2C613.title": "Field Guide"
	"chapter.7D07FDD67EE67215.title": "Welcome to the North Pole"
	"chapter.7D07FDD67EE67215.chapter_subtitle": [
		"Christmas is in trouble. Pull up a chair."
	]
	"task.497C515B3EF1A706.title": "I am ready to help"
	"quest.4DCC2697FB0B9A91.title": "Christmas Is in Trouble"
	"quest.4DCC2697FB0B9A91.quest_subtitle": "The North Pole needs every pair of hands."
	"quest.4DCC2697FB0B9A91.quest_desc": [
		"Something has gone wrong at the North Pole. Its spirits are trapped, the toy lines are cold, and the pantry is bare. Chips are how you get by here: make things worth buying and you will earn them. Start with your stocking."
	]
	"chapter.2EA6984255333DCF.title": "The First Machines"
	"chapter.2EA6984255333DCF.chapter_subtitle": [
		"Make it once by hand, then never again."
	]
	"quest.05A1F9B3EA14DE2E.title": "Andesite Alloy"
	"quest.05A1F9B3EA14DE2E.quest_subtitle": "The grey stuff that holds Create together."
	"quest.05A1F9B3EA14DE2E.quest_desc": [
		"Andesite and iron nuggets make andesite alloy, the base of every early Create machine: shafts, cogs, casings. Make it by hand today. By the end of this chapter a mixer makes it for you, and that is the whole idea of this pack."
	]
	"quest.7BEE285CCC7460D7.title": "The Andesite Age"
	"quest.7BEE285CCC7460D7.quest_subtitle": "A box for every machine."
	"quest.7BEE285CCC7460D7.quest_desc": [
		"Use andesite alloy on stripped logs to make andesite casing. Nearly every machine in this chapter is built around one: the millstone, the press, the mixer, the saw, the fan. Make a stack; you will go through it."
	]
	"quest.43FA1A61A5A20377.title": "Make It Turn"
	"quest.43FA1A61A5A20377.quest_subtitle": "Rotation is the lifeblood of a Create base."
	"quest.43FA1A61A5A20377.quest_desc": [
		"Every machine needs rotation. A water wheel in flowing water is free power that never runs out, and a large water wheel gives far more. Put it somewhere with room to spare: your first production line grows from this spot."
	]
	"quest.60857CA854DC52AC.title": "Catch the Wind"
	"quest.60857CA854DC52AC.quest_subtitle": "Power for the hilltops."
	"quest.60857CA854DC52AC.quest_desc": [
		"No river? A windmill bearing glued to sails gives power anywhere you can build tall, and every extra sail adds stress capacity. Assemble one and let it turn. A good windmill on a hill can run a small workshop all winter."
	]
	"quest.078A22D13BD97AEE.title": "Shifting Gears"
	"quest.078A22D13BD97AEE.quest_subtitle": "Fast or strong: pick one."
	"quest.078A22D13BD97AEE.quest_desc": [
		"A large cogwheel meshed with a small one doubles or halves the speed. Faster machines work quicker but cost more stress; the source only has so much. Gearboxes and encased shafts carry the rotation round corners and through walls."
	]
	"quest.35E9C0E66E9E82AD.title": "Conveyor"
	"quest.35E9C0E66E9E82AD.quest_subtitle": "Things should move themselves."
	"quest.35E9C0E66E9E82AD.quest_desc": [
		"Join two shafts with a mechanical belt. Belts carry items between machines and turn a pile of blocks into a production line. Run one from your storage past a machine and back, and watch the work happen without you."
	]
	"quest.7B93378B31B6F8C3.title": "Funnels and Chutes"
	"quest.7B93378B31B6F8C3.quest_subtitle": "In one side, out the other."
	"quest.7B93378B31B6F8C3.quest_desc": [
		"Funnels pull items off belts and push them into anything with an inventory; chutes drop them down a floor. Together they are the plumbing of every Create factory you will ever build. Use both to move something real."
	]
	"quest.2D6C48A4632400D4.title": "Grind It Down"
	"quest.2D6C48A4632400D4.quest_subtitle": "Grain in, flour out."
	"quest.2D6C48A4632400D4.quest_desc": [
		"A millstone grinds what you feed it: wheat to flour, flowers to dye, gravel to flint, bone to bone meal. The kitchen starts here. Power it, then feed it from a funnel or a hopper and collect from the side."
	]
	"quest.6BB02375EE1FFF0B.title": "Press Ahead"
	"quest.6BB02375EE1FFF0B.quest_subtitle": "Ingots in, sheets out."
	"quest.6BB02375EE1FFF0B.quest_desc": [
		"A mechanical press over a depot or belt turns ingots into sheets, the start of nearly every recipe beyond the basics. Over a basin it compacts instead. Iron, gold and copper sheets go into everything that comes next on this page."
	]
	"quest.7B1E7435B98D2AC2.title": "Kitted Out"
	"quest.7B1E7435B98D2AC2.quest_subtitle": "Read the stress before it stops you."
	"quest.7B1E7435B98D2AC2.quest_desc": [
		"Make a wrench and engineer's goggles from gold sheets. The wrench turns and picks up any Create block; the goggles show what each machine costs. Read a stressometer through them and you will know why a line stopped, before it stops."
	]
	"quest.7D2EA14C7C7A57C2.title": "Air Power"
	"quest.7D2EA14C7C7A57C2.quest_subtitle": "Wash it, smoke it, blast it."
	"quest.7D2EA14C7C7A57C2.quest_desc": [
		"An encased fan blowing through water washes, through fire smokes, and through lava blasts whatever passes in front of it. Process something on a belt in its stream. Bulk smelting, cooking and washing all start with this one block."
	]
	"quest.5EF48C56802EEDC6.title": "Timber!"
	"quest.5EF48C56802EEDC6.quest_subtitle": "Logs to planks, automatically."
	"quest.5EF48C56802EEDC6.quest_desc": [
		"An upright mechanical saw cuts logs into planks and stone into shapes as they pass under it on a belt. Cut something with one. On a moving contraption the same saw fells whole trees."
	]
	"quest.11CEBDBF935C4AE8.title": "Push and Pull"
	"quest.11CEBDBF935C4AE8.quest_subtitle": "Move the world, a block at a time."
	"quest.11CEBDBF935C4AE8.quest_desc": [
		"A mechanical piston pushes whole structures, and super glue decides what moves with it. Doors, lifts and drawbridges start here. Glue a group of blocks together and push a whole wall aside."
	]
	"quest.375AA80127FAA27D.title": "Moving with Purpose"
	"quest.375AA80127FAA27D.quest_subtitle": "A machine that works as it moves."
	"quest.375AA80127FAA27D.quest_desc": [
		"Put drills, saws or harvesters on a contraption and send it out on a piston, bearing or cart: a tree farm that fells its own forest, a drill face that digs a tunnel, a harvester that sweeps the fields. This is where Create stops being a workbench."
	]
	"quest.7503AC37CF41C36B.title": "Never by Hand Again"
	"quest.7503AC37CF41C36B.quest_subtitle": "A mixer makes the alloy now."
	"quest.7503AC37CF41C36B.quest_desc": [
		"A mechanical mixer over a basin combines ingredients without a crafting table. Mix andesite and iron nuggets into alloy and you never craft it by hand again. Dough, chocolate and, soon, brass come out of a basin too."
	]
	"quest.29FFDE4D5A1A6204.title": "The Copper Age"
	"quest.29FFDE4D5A1A6204.quest_subtitle": "Watertight."
	"quest.29FFDE4D5A1A6204.quest_desc": [
		"Copper ingots on stripped logs make copper casing, the waterproof shell of every fluid machine. Pipes, tanks, spouts and drains all need copper, and so does the steam engine at the end of this page. Find a good copper vein."
	]
	"quest.092D98FB67CF5295.title": "Pipes and Pumps"
	"quest.092D98FB67CF5295.quest_subtitle": "Water goes where you tell it."
	"quest.092D98FB67CF5295.quest_desc": [
		"Pull water into a pipe with a mechanical pump. Pipes and pumps move water, lava, milk, honey and chocolate anywhere in your base. Fluids are half of Create's recipes and nearly all of the kitchen, and a boiler drinks a lot of water."
	]
	"quest.06F63AFDD1B0E263.title": "The Spout"
	"quest.06F63AFDD1B0E263.quest_subtitle": "Fill, glaze, top."
	"quest.06F63AFDD1B0E263.quest_desc": [
		"A spout over a depot fills bottles and buckets and pours fluids onto items: honey on apples, chocolate on berries, lava on a blaze cake. Feed it from a fluid tank and fill something. Every dessert line in the kitchen ends at a spout."
	]
	"quest.0602DD406B2351E9.title": "Catch a Blaze"
	"quest.0602DD406B2351E9.quest_subtitle": "Fire, in a box, on purpose."
	"quest.0602DD406B2351E9.quest_desc": [
		"Take an empty blaze burner to the Nether and catch a blaze in it. Under a basin it heats your mixing; under a boiler it makes steam. Fed blaze cake, it superheats. Brass, chocolate, stews and frying all need its heat."
	]
	"quest.0B103E9F08E2B8FC.title": "The Powerhouse"
	"quest.0B103E9F08E2B8FC.quest_subtitle": "The water wheel was a warm-up."
	"quest.0B103E9F08E2B8FC.quest_desc": [
		"Build a boiler: at least four fluid tanks, a blaze burner beneath, a pump feeding water in, and a steam engine on the side with a shaft. Goggles on the tank show its heat, water and size; the lowest sets the level, and each level runs one more engine."
	]
	"reward.17091A799D98F12E.title": "Fireworks!"
	"quest.363868FA03E37D7B.title": "The Full-Size Boiler"
	"quest.363868FA03E37D7B.quest_subtitle": "Nine burners, nine engines, no cake."
	"quest.363868FA03E37D7B.quest_desc": [
		"Gather the parts for a full-size boiler: 72 fluid tanks (3 by 3, 8 high), 9 blaze burners and 9 steam engines. Built, it runs at level 9: nine lit burners give 9 heat, and it needs 90 mB of water a tick. Superheat the burners later and the same tank reaches 18."
	]
	"chapter.318D9480C16EFFBE.title": "The Brass Age"
	"chapter.318D9480C16EFFBE.chapter_subtitle": [
		"Where Create gets clever."
	]
	"quest.162CE88B477B267E.title": "Brass"
	"quest.162CE88B477B267E.quest_subtitle": "The metal of the machine age."
	"quest.162CE88B477B267E.quest_desc": [
		"Copper and zinc, mixed in a basin over a lit blaze burner, become brass. Brass opens the clever half of Create: logistics, sequenced assembly, trains, the full-size boiler, and the parts the casino tables are made from."
	]
	"quest.04BEBADB469586F0.title": "The Brass Age"
	"quest.04BEBADB469586F0.quest_subtitle": "A casing for clever machines."
	"quest.04BEBADB469586F0.quest_desc": [
		"Brass ingots on stripped logs make brass casing. Mechanical crafters, arms, display links and brass tunnels are all built into it. It is the andesite casing of this chapter: make plenty."
	]
	"quest.1D3987E8B7AEB444.title": "Supercharged"
	"quest.1D3987E8B7AEB444.quest_subtitle": "Rose quartz, polished."
	"quest.1D3987E8B7AEB444.quest_desc": [
		"Rose quartz is nether quartz soaked in redstone. Polish it with sandpaper, by hand or on a deployer, then set it over an iron sheet for an electron tube. Tubes are the brains of every brass machine, so you will need a lot of them."
	]
	"quest.497A914F8455C00B.title": "Robot Hands"
	"quest.497A914F8455C00B.quest_subtitle": "It uses things so you do not have to."
	"quest.497A914F8455C00B.quest_desc": [
		"Place and power a deployer. It holds an item and uses it like a player would: placing, applying, polishing, assembling. With belts and presses it builds things in sequence, and sequences are where real factories begin."
	]
	"quest.70221A959234FE1A.title": "Precision"
	"quest.70221A959234FE1A.quest_subtitle": "Gold, cogs and patience."
	"quest.70221A959234FE1A.quest_desc": [
		"Build a sequenced assembly line and make a precision mechanism: a gold sheet, then cogwheels, large cogwheels and iron nuggets, deployed onto it in order, five times round. It is the first real factory job, and arms, gauges and the best machines all need one."
	]
	"quest.240770CC7F582457.title": "The Mechanical Arm"
	"quest.240770CC7F582457.quest_subtitle": "Pick it up, put it down, all day."
	"quest.240770CC7F582457.quest_desc": [
		"A mechanical arm moves items between points you choose: belts, depots, machines, chests, burners. Watch yours move its first item. It is the most useful single block in a factory, and the fastest way to tidy a messy line."
	]
	"quest.2AEA10F9FB69206E.title": "Many Hands"
	"quest.2AEA10F9FB69206E.quest_subtitle": "Big recipes need big crafting."
	"quest.2AEA10F9FB69206E.quest_desc": [
		"Mechanical crafters link into grids for recipes too big for a table. Build a grid and make your first pair of crushing wheels on it, then place and power them. The casino tables and Santa's toys are built on grids like this too."
	]
	"quest.4042934E505A1B15.title": "Smart Logistics"
	"quest.4042934E505A1B15.quest_subtitle": "Only what you ask for."
	"quest.4042934E505A1B15.quest_desc": [
		"Brass funnels and tunnels take filters: split a belt evenly, sort ores from cobble, send only flour to the oven. Smart chutes do the same going down. Build a line that sorts its own output and the mess stops piling up."
	]
	"quest.135DBA54FAE60B84.title": "Double Your Ore"
	"quest.135DBA54FAE60B84.quest_subtitle": "Crush, wash, smelt."
	"quest.135DBA54FAE60B84.quest_desc": [
		"Raw ore through crushing wheels comes out crushed, often with a bonus, and washing it in a fan's water stream gives nuggets and extras. Crushed ore smelts too. Run iron through and every vein you mine goes much further."
	]
	"quest.4287B06EBDBF3946.title": "Redstone Refinery"
	"quest.4287B06EBDBF3946.quest_subtitle": "Red dust from a Nether rock."
	"quest.4287B06EBDBF3946.quest_desc": [
		"Crush netherrack between crushing wheels for cinder flour. Brew Strength in a heated basin: water and nether wart, then blaze powder. A spout pours 25 mB onto each cinder flour and makes one redstone, so one bucket makes forty. Night Vision the same way makes glowstone."
	]
	"quest.6A8FA7415B3D1311.title": "Tapping the Mantle"
	"quest.6A8FA7415B3D1311.quest_subtitle": "A lake of lava, on tap."
	"quest.6A8FA7415B3D1311.quest_desc": [
		"Lower a hose pulley into a lava lake big enough to count as endless and pump from it. Lava goes into blaze cakes, blasting fans and stone generators, and this way you never carry a bucket again."
	]
	"quest.19D69A83BF60C0FF.title": "Blaze Cake"
	"quest.19D69A83BF60C0FF.quest_subtitle": "Fuel for a superheated fire."
	"quest.19D69A83BF60C0FF.quest_desc": [
		"Compact an egg, sugar and cinder flour in a basin under a press for a blaze cake base, then spout 250 mB of lava onto it. A blaze burner fed a cake superheats: double heat for a boiler, and the hottest mixing recipes."
	]
	"quest.722541F70C9DFC99.title": "Combust-o-Tron"
	"quest.722541F70C9DFC99.quest_subtitle": "Nobody has time to feed nine burners."
	"quest.722541F70C9DFC99.quest_desc": [
		"Program a mechanical arm to feed a blaze burner. Supply the arm with blaze cakes from a chest or belt and the fire stays superheated without you. A full boiler needs nine burners kept fed like this."
	]
	"quest.6522A69D9B414E81.title": "Read-Outs"
	"quest.6522A69D9B414E81.quest_subtitle": "Numbers on the wall."
	"quest.6522A69D9B414E81.quest_desc": [
		"A display link reads a block and writes it to a display board or nixie tubes: stock counts, train times, or your boiler's status. Put one on a tank of your boiler and you can read its level from across the room."
	]
	"reward.4F47A9545FF58146.title": "Fireworks!"
	"quest.6AD25BF88D33507A.title": "Full Steam"
	"quest.6AD25BF88D33507A.quest_subtitle": "Level 18. The biggest boiler there is."
	"quest.6AD25BF88D33507A.quest_desc": [
		"Run a boiler at level 18. It needs 72 tank blocks (a 3 by 3 tank, 8 high), 180 mB of water a tick, and 18 heat: nine superheated burners, kept fed. Each level drives one engine at full, so hang 18 steam engines on it. That is power for a whole district."
	]
	"chapter.58F729BA1D46E8B3.title": "The Quarry"
	"chapter.58F729BA1D46E8B3.chapter_subtitle": [
		"Lava meets a fluid: stone, for ever."
	]
	"quest.43313C459681A4B6.title": "The Cobblestone Generator"
	"quest.43313C459681A4B6.quest_subtitle": "Water, lava, a drill. Stone for ever."
	"quest.43313C459681A4B6.quest_desc": [
		"There is no machine in this pack that makes stone out of nothing. Stone comes from fluids: flowing lava that touches water cools into cobblestone, and the water is never used up. Put a drill on it and you have every cobblestone you will ever need."
	]
	"quest.5A8A7B1615173966.title": "Smooth from the Start"
	"quest.5A8A7B1615173966.quest_subtitle": "Lava that falls onto water."
	"quest.5A8A7B1615173966.quest_desc": [
		"Lava that flows down onto water turns the water into stone, not cobblestone. Keep a water source topped up under a lava fall and drill the stone it leaves: no furnace needed for stone bricks."
	]
	"quest.52E91BA3D7734CCC.title": "Obsidian on Tap"
	"quest.52E91BA3D7734CCC.quest_subtitle": "Water meets a lava source."
	"quest.52E91BA3D7734CCC.quest_desc": [
		"Water touching a lava source turns it to obsidian. A hose pulley in a lava lake refills the source after every block, so a drill and a pulley make obsidian without a bucket in sight."
	]
	"quest.6383F2F7A5F84E9A.title": "Basalt Columns"
	"quest.6383F2F7A5F84E9A.quest_subtitle": "Soul soil below, blue ice beside."
	"quest.6383F2F7A5F84E9A.quest_desc": [
		"Lava that flows over soul soil next to blue ice becomes basalt. Bring back soul soil from one Nether trip; a fan blowing through soul fire makes more from dirt, and freezing packed ice makes blue ice."
	]
	"quest.67C656B10167A7AC.title": "Limestone"
	"quest.67C656B10167A7AC.quest_subtitle": "Lava meets honey."
	"quest.67C656B10167A7AC.quest_desc": [
		"Flowing lava that touches honey cools into limestone, the oldest trick in Create. Melt honey blocks in a heated mixer or drain honey bottles in an item drain. Build it as a generator: the pool sits beside the spot, lava falls into the spot from a source two blocks up, and a drill faces it. Lava never reacts with fluid below it."
	]
	"quest.3230F577DF600307.title": "Scoria"
	"quest.3230F577DF600307.quest_subtitle": "Lava meets chocolate."
	"quest.3230F577DF600307.quest_desc": [
		"Flowing lava that touches Create's chocolate cools into scoria. A heated mixer makes the chocolate from sugar, cocoa beans and milk. Eight scoria and a black dye make scorchia by hand, or see the next quest. Build it like the limestone generator."
	]
	"quest.7B29C1ACD97F510A.title": "Scorchia"
	"quest.7B29C1ACD97F510A.quest_subtitle": "Lava meets dark chocolate."
	"quest.7B29C1ACD97F510A.quest_desc": [
		"Dark chocolate from Create Confectionery makes scorchia. Mix sugar, cocoa butter, two cocoa beans and milk over a blaze burner. Build it like the limestone generator."
	]
	"quest.3F53BA96877F4F28.title": "Diorite"
	"quest.3F53BA96877F4F28.quest_subtitle": "Lava meets white chocolate."
	"quest.3F53BA96877F4F28.quest_desc": [
		"White chocolate makes diorite: sugar, cocoa butter and milk in a heated mixer. Crushing diorite gives a little quartz. Build it like the limestone generator."
	]
	"quest.2587A9EB4621C1B5.title": "Dripstone"
	"quest.2587A9EB4621C1B5.quest_subtitle": "Lava meets caramel."
	"quest.2587A9EB4621C1B5.quest_desc": [
		"Caramel makes dripstone: two sugar and water in a heated mixer. Milling a dripstone block gives a ball of clay, so this is also the easy way to bricks and terracotta. Build it like the limestone generator."
	]
	"quest.54EEE72ADB58708F.title": "Granite"
	"quest.54EEE72ADB58708F.quest_subtitle": "Lava meets ruby chocolate."
	"quest.54EEE72ADB58708F.quest_desc": [
		"Ruby chocolate makes granite, and ruby chocolate needs dragon's breath. Mix sugar, cocoa beans, milk and a bottle of breath over a blaze burner. Build it like the limestone generator."
	]
	"quest.190A62B3F5BC9A67.title": "Calcite"
	"quest.190A62B3F5BC9A67.quest_subtitle": "Lava meets icing."
	"quest.190A62B3F5BC9A67.quest_desc": [
		"Icing from our kitchen makes calcite: two icing sugar and milk in a mixer. Aeronautics' levitite blend makes calcite too, if you have some spare. Crushing calcite gives bone meal. Build it like the limestone generator."
	]
	"quest.26DA756CCF0D9D33.title": "Crimsite"
	"quest.26DA756CCF0D9D33.quest_subtitle": "Lava meets cranberry punch."
	"quest.26DA756CCF0D9D33.quest_desc": [
		"Cranberry punch makes crimsite: ice, sugar, cranberry jam and orange juice in a mixer. In this pack the ore stones are building stone, and crushing them gives gravel. Build it like the limestone generator."
	]
	"quest.2127C657611F1D19.title": "Ochrum"
	"quest.2127C657611F1D19.quest_subtitle": "Lava meets eggnog."
	"quest.2127C657611F1D19.quest_desc": [
		"Our eggnog makes ochrum, Create's golden layered stone: two eggs, sugar and milk in a mixer. Crushing it gives gravel here, not gold: the ore stones are for building. Build it like the limestone generator."
	]
	"quest.2EA23C2DCFEE4A6E.title": "Veridium"
	"quest.2EA23C2DCFEE4A6E.quest_subtitle": "Lava meets green tea."
	"quest.2EA23C2DCFEE4A6E.quest_desc": [
		"Green tea makes veridium, Create's green layered stone. Brew it in a Farmer's Respite kettle, or mix two green tea leaves and water over a blaze burner and pump the tea into a pool. Build it like the limestone generator."
	]
	"quest.16C1C12B70C09430.title": "Asurine"
	"quest.16C1C12B70C09430.quest_subtitle": "Lava meets gambler's tea."
	"quest.16C1C12B70C09430.quest_desc": [
		"Gambler's tea makes asurine, Create's blue layered stone: coffee berries, glow berries and water, in a kettle or a heated mixer. Glow berries grow in lush caves. Build it like the limestone generator."
	]
	"quest.45E448D313F48A29.title": "Rhyolite"
	"quest.45E448D313F48A29.quest_subtitle": "Lava meets rose hip tea."
	"quest.45E448D313F48A29.quest_desc": [
		"Rose hip tea makes Twigs' rhyolite, a warm red stone with its own bricks and tiles: two rose hips and water, in a kettle or a heated mixer. Build it like the limestone generator."
	]
	"quest.2987737183978F64.title": "Schist"
	"quest.2987737183978F64.quest_subtitle": "Lava meets black tea."
	"quest.2987737183978F64.quest_desc": [
		"Black tea makes Twigs' schist, a grey banded stone with its own bricks and tiles: two black tea leaves and water, in a kettle or a heated mixer. Build it like the limestone generator."
	]
	"quest.76A87BCBEDEFB727.title": "Alpine Gneiss"
	"quest.76A87BCBEDEFB727.quest_subtitle": "Lava meets curdled milk."
	"quest.76A87BCBEDEFB727.quest_desc": [
		"Bitterballen's curdled milk makes Alpine Whispers' gneiss: crushed nether wart and milk in a heated mixer. Otherwise gneiss is only found high in the mountains. Build it like the limestone generator."
	]
	"quest.6F9F3A74E02D6BC9.title": "Rubblestone"
	"quest.6F9F3A74E02D6BC9.quest_subtitle": "Lava meets compost tea."
	"quest.6F9F3A74E02D6BC9.quest_desc": [
		"Ratatouille's compost tea makes Hearth & Timber's groutless rubblestone. The composter brews it from compost mass. Build it like the limestone generator."
	]
	"quest.3E572CAF47603709.title": "Bloodstone"
	"quest.3E572CAF47603709.quest_subtitle": "Lava meets sweet berry jam."
	"quest.3E572CAF47603709.quest_desc": [
		"Create Factory's sweet berry jam makes Twigs' bloodstone. The jam needs a superheated mixer: two sugar and sweet berries over a blaze burner fed blaze cake. Build it like the limestone generator."
	]
	"quest.6E6EA369F0D8E659.title": "Prismarine"
	"quest.6E6EA369F0D8E659.quest_subtitle": "Lava meets melon juice."
	"quest.6E6EA369F0D8E659.quest_desc": [
		"Ratatouille's melon juice makes prismarine: four melon slices and sugar in a mixer. Crushing prismarine gives its shards back, so prismarine bricks and dark prismarine come from the same generator. Build it like the limestone generator."
	]
	"quest.06102D3CB1467FE3.title": "Tuff"
	"quest.06102D3CB1467FE3.quest_subtitle": "Lava meets crude oil."
	"quest.06102D3CB1467FE3.quest_desc": [
		"Crude oil makes tuff, and crude oil only comes from a Diesel Generators pumpjack on an oil deposit. Tuff crushes into a little of five metals, which is why it is the hard one. Build it like the limestone generator."
	]
	"quest.2E95380CC48CEC03.title": "Concrete Without the Water"
	"quest.2E95380CC48CEC03.quest_subtitle": "Lava meets dye."
	"quest.2E95380CC48CEC03.quest_desc": [
		"Dragons Plus turns any dye into a dye fluid in a mixer with water, and lava that touches a dye fluid cools into concrete of that colour. All sixteen colours work; red is for Christmas. Build it like the limestone generator."
	]
	"quest.7F8B2280AF445E9A.title": "End Stone"
	"quest.7F8B2280AF445E9A.quest_subtitle": "Lava meets dragon's breath."
	"quest.7F8B2280AF445E9A.quest_desc": [
		"Flowing lava that touches dragon's breath cools into end stone. Drain bottles of breath in an item drain to fill the pool; one trip to the End keeps the levitite and the purpur coming for good. Build it like the limestone generator."
	]
	"quest.2F844B3F1EEA6F89.title": "Crystallised Oil"
	"quest.2F844B3F1EEA6F89.quest_subtitle": "Lava meets frying oil."
	"quest.2F844B3F1EEA6F89.quest_desc": [
		"Bitterballen's frying oil sets into crystallised oil where flowing lava touches it: crushed sunflower seeds and water in a heated mixer make the oil. Build it like the limestone generator."
	]
	"chapter.1307FF7F66F8AE5E.title": "The Enchanting Line"
	"chapter.1307FF7F66F8AE5E.chapter_subtitle": [
		"Experience by the bucket, enchantments by the press."
	]
	"quest.4DA03BF61E993584.title": "Experience You Can Hold"
	"quest.4DA03BF61E993584.quest_subtitle": "Crushing wheels leave something behind."
	"quest.4DA03BF61E993584.quest_desc": [
		"Ore through crushing wheels often drops Nuggets of Experience, and Deployers that kill or mine collect them too. Nine make a Block of Experience. This is the raw material for everything in this chapter: start saving them now."
	]
	"quest.2E8694C7301004DD.title": "Liquid Experience"
	"quest.2E8694C7301004DD.quest_subtitle": "Grind it down, pipe it around."
	"quest.2E8694C7301004DD.quest_desc": [
		"A Mechanical Grindstone grinds experience nuggets into liquid experience, 3 mB a nugget and 27 a block, and grinds the enchantments off old gear into the same fluid. Pump it into a tank. Watch one strip an enchanted item."
	]
	"quest.13F782ECDCE5E8F0.title": "Bank Your Levels"
	"quest.13F782ECDCE5E8F0.quest_subtitle": "Experience, on deposit."
	"quest.13F782ECDCE5E8F0.quest_desc": [
		"Put a Block of Experience on a Dragons Plus fluid hatch to make an Experience Hatch. Click it to pour your own levels into a tank, and take them back later. No more losing thirty levels to a creeper."
	]
	"quest.379B71B01E545234.title": "The Printing Press"
	"quest.379B71B01E545234.quest_subtitle": "One enchanted book, many copies."
	"quest.379B71B01E545234.quest_desc": [
		"A Printer (a spout on an iron block, under a brass sheet) copies an enchanted book with liquid experience and a blank book. It copies written books, names, banner patterns and package addresses too. Copy an enchanted book."
	]
	"quest.5DBB957D6A35DF8E.title": "The Blaze Enchanter"
	"quest.5DBB957D6A35DF8E.quest_subtitle": "Blazes can do more than boil water."
	"quest.5DBB957D6A35DF8E.quest_desc": [
		"A smithing table upgrades a Blaze Burner with an enchanting table into a Blaze Enchanter. The blaze upgrade template comes from bastion and Nether fortress chests, then copies itself. Feed it liquid experience and enchant an item."
	]
	"quest.2626F3D7FA0C4A58.title": "The Blaze Forger"
	"quest.2626F3D7FA0C4A58.quest_subtitle": "An anvil that never wears out."
	"quest.2626F3D7FA0C4A58.quest_desc": [
		"The same upgrade with an anvil makes a Blaze Forger. It merges two of the same item, strips or adds enchantments, and applies enchanting templates pressed from Blocks of Experience. Merge two items."
	]
	"quest.7D07BCD66230D2B9.title": "Super Experience"
	"quest.7D07BCD66230D2B9.quest_subtitle": "Strike while the block is hot."
	"quest.7D07BCD66230D2B9.quest_desc": [
		"Lightning that strikes a Block of Experience turns it into Super Experience. A blaze enchanter fed blaze cake super-enchants with it, giving combinations no enchanting table allows. Bring a lightning rod to a thunderstorm."
	]
	"chapter.3FB53030CEF3907D.title": "Making a Living"
	"chapter.3FB53030CEF3907D.chapter_subtitle": [
		"Honest chips for honest work."
	]
	"quest.1E574C74D0CF56CB.title": "How the North Pole Pays"
	"quest.1E574C74D0CF56CB.quest_subtitle": "Nothing crafts a chip."
	"quest.1E574C74D0CF56CB.quest_desc": [
		"No recipe makes a chip. Every one is paid for work somebody wanted: an elf's shift, goods sold at the Exchange, a Notice Board order, a delivery flown, a shop of your own. Start at the Cashier's Cage in the village, the bank: use it with a chip to break it into smaller ones (sneak for the whole stack). It never takes a cut."
	]
	"quest.18FDF9691693E472.title": "Elf Shifts"
	"quest.18FDF9691693E472.quest_subtitle": "Sort the post, get paid."
	"quest.18FDF9691693E472.quest_desc": [
		"Use the Elf Mail desk to start a shift of ten letters and file each in the pigeonhole whose plate matches its stamp. Ten filed pays real chips; three mix-ups and the shift is unpaid. A small wage, a few shifts a day, always open. Nearly broke? Santa's Mercy leaves you Gift Chips once a day: they bet at any game, and wins pay real chips."
	]
	"quest.4DF28181384AE73C.title": "The North Pole Exchange"
	"quest.4DF28181384AE73C.quest_subtitle": "Sell what you make."
	"quest.4DF28181384AE73C.quest_desc": [
		"The Exchange buys made things: dishes, Create and airship parts, crops packed into bales and crates; never raw ore, logs or loose crops. Use the counter holding a stack to sell it. Each sale pulls that price down for everyone until it recovers, so make several goods, not a mountain of one. No daily limit: prices are the brake."
	]
	"quest.35D0AD821D56CDD4.title": "Wanted by Sunday"
	"quest.35D0AD821D56CDD4.quest_subtitle": "The Notice Board."
	"quest.35D0AD821D56CDD4.quest_desc": [
		"The Notice Board pins up the week: three North Pole Wants that pay half again at the Exchange, and three orders for bigger lots. Use the board holding an order's goods to hand them in; part loads count, and a filled order pays one lump sum, once each, however far prices have sagged. Both change on Monday: plan your week: sell a Want, fill an order."
	]
	"quest.4B8CE993D9A0F9A1.title": "Spend It at Santa's"
	"quest.4B8CE993D9A0F9A1.quest_subtitle": "Where spent chips go."
	"quest.4B8CE993D9A0F9A1.quest_desc": [
		"Santa's Shop sells decorations, treats and toy blueprints; chips spent there are gone for good, and it takes real chips only. What it does not sell you make: a Notice Board of your own is a Create clipboard on brass sheets and spruce posts, on Mechanical Crafters. Hang one in your factory and hand orders in there."
	]
	"quest.068C2800EC9D4851.title": "A Counter of Your Own"
	"quest.068C2800EC9D4851.quest_subtitle": "Sell by the beltful."
	"quest.068C2800EC9D4851.quest_desc": [
		"Build an Exchange counter on Mechanical Crafters: a split-flap bank from your Workshop, nixie tubes, a brass funnel and brass casings. It takes goods from belts, funnels and arms through its hatch and sells every unit for whoever placed it. The chips wait in its till (watch the nixie tubes); an empty hand collects them."
	]
	"quest.0EFC2DA5F4BEF5FC.title": "Your First Thousand"
	"quest.0EFC2DA5F4BEF5FC.quest_subtitle": "Colour up."
	"quest.0EFC2DA5F4BEF5FC.quest_desc": [
		"Quests never pay a thousand chip. Carry a thousand chips' worth to the Cashier's Cage and use it with an empty hand: everything in your pockets colours up into the fewest chips there can be, and nothing is lost. However you earned it, a thousand chip means you have found your feet. Keep it as a trophy, or put it to work."
	]
	"quest.1F68120875F5D236.title": "Delivered"
	"quest.1F68120875F5D236.quest_subtitle": "A hundred chips a sack."
	"quest.1F68120875F5D236.quest_desc": [
		"Every sealed sack that lands in Santa's Sleigh pays 100 chips to whoever placed the hoist that tied it, however it got there: by hand, belt, train or airship, and however many you send. If you are away, the house keeps your pay till you are back. Sell a toy at the Exchange and it fetches far less than its share of a sack."
	]
	"quest.01E302E4BEC06E1C.title": "Mail Order"
	"quest.01E302E4BEC06E1C.quest_subtitle": "Ship it by frog."
	"quest.01E302E4BEC06E1C.quest_desc": [
		"Packagers box up items and frogports throw the boxes across your network. Once one runs, a single order can pull goods from every corner of your base and post them wherever they need to go. It is also the back room of a shop."
	]
	"quest.4912A2FF86EE33F2.title": "Open for Business"
	"quest.4912A2FF86EE33F2.quest_subtitle": "Your stall, your prices, their chips."
	"quest.4912A2FF86EE33F2.quest_desc": [
		"Link your stock to a stock ticker, seat a shopkeeper behind it and lay table cloths with a price in chips on each: neighbours buy straight from your stock, and their chips go to you, not the market. You set the price, so sell what the Exchange does not buy, to friends who would rather buy it than build the line."
	]
	"quest.10BE983EC70E1433.title": "Made to Order"
	"quest.10BE983EC70E1433.quest_subtitle": "The factory that runs itself."
	"quest.10BE983EC70E1433.quest_desc": [
		"A factory gauge watches your stock and orders the ingredients it needs, then sends the product on. Chain a few together and your shop shelves, your Notice Board orders and your counter's belt keep themselves full while you are away. That is how fortunes start."
	]
	"quest.1B7B5521AF591BB6.title": "The North Pole Tally"
	"quest.1B7B5521AF591BB6.quest_subtitle": "Know what your line makes."
	"quest.1B7B5521AF591BB6.quest_desc": [
		"Before you count on a line to earn, find out what it really makes. A North Pole Tally counts what you feed it, a minute at a time. It is a test bench: what goes in is sent to Santa, not sold, so measure, then turn the belt to your counter. The quests after it ask for a rate held for minutes: proof a factory really works."
	]
	"task.18482E36E891AD24.title": "Deliver 30 andesite alloy a minute for 10 minutes"
	"quest.3958B466FD1AD867.title": "Alloy Foundry"
	"quest.3958B466FD1AD867.quest_subtitle": "Thirty a minute for ten minutes."
	"quest.3958B466FD1AD867.quest_desc": [
		"Thirty andesite alloy a minute, held for ten minutes. A real foundry: mixers fed andesite from a quarry, with zinc or iron nuggets arriving on time. Most factories on the server will run on what this makes."
	]
	"task.14A9A7B8EDD97719.title": "Deliver 4 precision mechanisms a minute for 5 minutes"
	"reward.360F13786D941D9D.title": "Fireworks!"
	"quest.764395C6373B64A1.title": "Mechanism Works"
	"quest.764395C6373B64A1.quest_subtitle": "Four a minute, for five."
	"quest.764395C6373B64A1.quest_desc": [
		"Four precision mechanisms a minute for five minutes means several sequenced lines running side by side, fed gold sheets and cogs without a gap. The market always wants mechanisms; this is how you supply it."
	]
	"task.63DEF59CC0A0B293.title": "Deliver 6 boxes of fries a minute for 5 minutes"
	"quest.6A4E0F47C1E08D99.title": "Fry Shop Rush"
	"quest.6A4E0F47C1E08D99.quest_subtitle": "Six boxes a minute, five minutes straight."
	"quest.6A4E0F47C1E08D99.quest_desc": [
		"The lunch rush: six boxes of fries a minute for five minutes. Potatoes, oil and cardboard all have to arrive on time, and the fryer must never run dry. Keep the oil tank topped up."
	]
	"chapter.11D71CA7090F9551.title": "The Casino"
	"chapter.11D71CA7090F9551.chapter_subtitle": [
		"The house always wins. Eventually."
	]
	"quest.17B3295222734544.title": "The Casino Floor"
	"quest.17B3295222734544.quest_subtitle": "Blackjack, Hold'em and the wheel."
	"quest.17B3295222734544.quest_desc": [
		"Walk the floor: blackjack, where the dealer stands on seventeen; Hold'em, where you play your friends and the house only rakes; and roulette, a single zero and a ball that never lies. Every bet is a real chip on the felt."
	]
	"quest.25E6B1D27ECC0874.title": "The Wheel of Gifts"
	"quest.25E6B1D27ECC0874.quest_subtitle": "Fifty-four segments and a clapper."
	"quest.25E6B1D27ECC0874.quest_desc": [
		"Put a chip on a symbol's spot on the felt, then anyone uses the wheel: it spins eight seconds and the clapper picks the segment. Snowflakes pay even money, holly two to one, up to forty to one on Santa or the single lump of Coal. A Gift Chip bets as a 1. In Advent, an empty hand on a symbol takes a free spin once a day, paid in Gift Chips. Win a spin."
	]
	"quest.4FD3128EC2BDE93E.title": "Behind the Silver"
	"quest.4FD3128EC2BDE93E.quest_subtitle": "One card a day, all through Advent."
	"quest.4FD3128EC2BDE93E.quest_desc": [
		"From 1 December, click the calendar on an Advent Kiosk for the day's scratch card: 10 chips, one a day until the 24th. Use it and rub off the nine silver panels; three alike win that symbol's prize, up to 2,500 for three Santas. Buy your first card."
	]
	"quest.3244EFB48B457838.title": "The Christmas Eve Draw"
	"quest.3244EFB48B457838.quest_subtitle": "Three winning tickets, drawn live."
	"quest.3244EFB48B457838.quest_desc": [
		"Click the kiosk's counter or drum for a draw ticket, 50 chips each, as many as you like. Most of the takings go in the pot, and on 24 December at 20:00 the drum spins live for three winners: half the pot, then three tenths, then a fifth. Buy a ticket."
	]
	"quest.299AAAEF4829DB19.title": "The Casino Workshop"
	"quest.299AAAEF4829DB19.quest_subtitle": "Loom, Press and Lathe, under one roof."
	"quest.299AAAEF4829DB19.quest_desc": [
		"Seven wide, nine deep, six high: an andesite-casing floor over its gearboxes, walls and roof of Site Casing (brick on andesite casing) or Window Casing, the controller mid-front, ports for items, fluid and drive, and a Loom, Press and Lathe on a two-lane Line. Drive it at 16 RPM or more. JEI's Casino Workshop page shows every block."
		""
		"{image:cccasino:textures/gui/quest/mb_workshop.png width:200 height:78 align:center}"
	]
	"quest.0F03E2ABFFB16E4D.title": "Brass Fittings"
	"quest.0F03E2ABFFB16E4D.quest_subtitle": "Rolled, turned, polished."
	"quest.0F03E2ABFFB16E4D.quest_desc": [
		"A Crafts & Additions Rolling Mill rolls brass ingots into rods, and the Workshop Lathe turns each rod into two rough brass fittings. Polish them with sandpaper, by hand or with a Deployer. Rails, trays, stools and table trim all take fittings, so set the line up once."
	]
	"quest.539B89CF91B6A862.title": "Green Baize"
	"quest.539B89CF91B6A862.quest_subtitle": "Woven, fulled and dyed."
	"quest.539B89CF91B6A862.quest_desc": [
		"Feed the Workshop three string, a green dye and a bucket's worth of water through its ports: the Loom weaves it, fulls it in the water and dyes it tournament green, two felts at a time. Casino felt goes on every table, under every printed layout. It is the first thing your Workshop makes."
	]
	"quest.367F247FAC4883D3.title": "A Fresh Deck"
	"quest.367F247FAC4883D3.quest_subtitle": "Printed, varnished, cut."
	"quest.367F247FAC4883D3.quest_desc": [
		"Smoke charcoal for carbon black, then the Press makes a black-core board from it with paper and water. Print it with red and black ink (dye and seed oil in a mixer), varnish it under a Spout and the Press cuts a deck from two sheets. Card varnish is seed oil and honey in a heated mixer."
	]
	"quest.49AF6C93F1CE98F3.title": "The Padded Rail"
	"quest.49AF6C93F1CE98F3.quest_subtitle": "Spruce, velvet and brass."
	"quest.49AF6C93F1CE98F3.quest_desc": [
		"Turn a spruce core on the Lathe, pad and upholster it in velvet on the Loom, then cap it with brass fittings that a Deployer has polished with sandpaper. Every table is ringed with them."
	]
	"quest.046BF9F97A37F92E.title": "The Chip Tray"
	"quest.046BF9F97A37F92E.quest_subtitle": "Made on a belt."
	"quest.046BF9F97A37F92E.quest_desc": [
		"A brass sheet rides a sequenced-assembly belt: a Deployer fits a polished fitting, another lays velvet, a Spout varnishes the rim and a Press shapes the tray. Every table keeps its chips in one."
	]
	"quest.39B0D878CD31828F.title": "Casino Pieces"
	"quest.39B0D878CD31828F.quest_subtitle": "Every game is built, not crafted."
	"quest.39B0D878CD31828F.quest_desc": [
		"Every casino game goes together from pieces the Workshop makes. A small blackjack table takes a Dealer's Station, a Card Shoe and two Padded Rail Sections. In JEI, U on a piece shows every game it goes into (the casino tab); R on a game shows its layout."
		""
		"{image:cccasino:textures/gui/quest/mb_kit.png width:200 height:78 align:center}"
	]
	"task.1AD926128CE3C763.title": "Got it"
	"quest.53BA852B2FDB1B1A.title": "How a Game Goes Together"
	"quest.53BA852B2FDB1B1A.quest_subtitle": "Pieces, then the cloth."
	"quest.53BA852B2FDB1B1A.quest_desc": [
		"Place the pieces in the frame JEI shows, then use the printed cloth on it: the table forms. Holding a piece outlines what is missing in blue and a wrong piece in red; goggles on the Dealer's Station list the rest. Break a piece and put it back and it forms again. Sneak with a wrench to lift the cloth."
		""
		"{image:cccasino:textures/gui/quest/mb_guide.png width:200 height:78 align:center}"
	]
	"quest.5BD417BE5DE016AD.title": "Deal for Your Friends"
	"quest.5BD417BE5DE016AD.quest_subtitle": "The small blackjack table."
	"quest.5BD417BE5DE016AD.quest_desc": [
		"Make a Dealer's Station, a Card Shoe and two Padded Rail Sections, set them in their two-by-two frame and lay a printed blackjack layout on the felt: the table forms. Put the shoe on Create power. A mechanical crafter makes two Casino Stools from velvet, a brass fitting and a shaft: seat your friends."
		""
		"{image:cccasino:textures/gui/quest/mb_blackjack_table_small.png width:200 height:78 align:center}"
	]
	"quest.09F4E97815BACFA7.title": "The House Table"
	"quest.09F4E97815BACFA7.quest_subtitle": "Five seats and a dealer console."
	"quest.09F4E97815BACFA7.quest_desc": [
		"The medium table adds a Dealer's Apron with the dealer console in it: golden and brass sheets, a nixie read-out and a precision mechanism. Three rail sections across the front, the cloth laid last. This is the table the casino floor is built on."
		""
		"{image:cccasino:textures/gui/quest/mb_blackjack_table.png width:200 height:78 align:center}"
	]
	"quest.07247796C5F51FB3.title": "High Stakes"
	"quest.07247796C5F51FB3.quest_subtitle": "The large blackjack table."
	"quest.07247796C5F51FB3.quest_desc": [
		"Five wide and three deep: two Dealer's Aprons, four Felt Beds and seven Rail Sections round the station and the shoe. Lay the blackjack layout on the big frame: it is the biggest blackjack table there is, for the biggest games of the season."
		""
		"{image:cccasino:textures/gui/quest/mb_blackjack_table_large.png width:200 height:78 align:center}"
	]
	"quest.0540CCBE9A343034.title": "Hold'em at Home"
	"quest.0540CCBE9A343034.quest_subtitle": "A shuffler of your own."
	"quest.0540CCBE9A343034.quest_desc": [
		"The poker table needs a card shuffler, made on a sequenced-assembly line: a precision mechanism takes cogwheels, rubber rollers and an electron tube, twice round. The Workshop houses it in a Card Shuffler; ring the oval with rail sections and lay the poker layout."
		""
		"{image:cccasino:textures/gui/quest/mb_poker_table.png width:200 height:78 align:center}"
	]
	"quest.58AF8CB9EC71E889.title": "Spin the Wheel"
	"quest.58AF8CB9EC71E889.quest_subtitle": "Bowl, frets, ring and bearing."
	"quest.58AF8CB9EC71E889.quest_desc": [
		"Turn a dark-oak bowl on the Lathe and send it down a sequenced line: a Spout varnishes it, Deployers fit brass frets, a spun number ring and a mechanical bearing. The Workshop sets it in a Wheel Bowl; lay the roulette layout on its frame."
		""
		"{image:cccasino:textures/gui/quest/mb_roulette_table.png width:200 height:78 align:center}"
	]
	"quest.70B9DA851B83DADE.title": "Jingle Reels"
	"quest.70B9DA851B83DADE.quest_subtitle": "Three reels and a sequenced stop."
	"quest.70B9DA851B83DADE.quest_desc": [
		"Spin iron drums on the Lathe and print their reels on the Press, then bank three of them on a shaft with a sequenced gearshift to stop them in turn. The Workshop builds them into a Reel Drum Housing: stand it on a Cabinet Plinth and the reels can roll."
		""
		"{image:cccasino:textures/gui/quest/mb_slot_cabinet.png width:200 height:78 align:center}"
	]
	"reward.3951FF9A2E2C7F8D.title": "Fireworks!"
	"quest.11C16135B26F8B1F.title": "Grand Opening"
	"quest.11C16135B26F8B1F.quest_subtitle": "Every table, made by you."
	"quest.11C16135B26F8B1F.quest_desc": [
		"A poker table, a roulette table and a slot cabinet, every piece made in your own Workshop and put together on your own floor. Throw the doors open: the North Pole has a casino of its own making."
	]
	"quest.26329079A83DBAA0.title": "Punto Banco"
	"quest.26329079A83DBAA0.quest_subtitle": "Player, Banker or Tie."
	"quest.26329079A83DBAA0.quest_desc": [
		"Sit at a baccarat table and put chips in your seat's boxes: PLAYER, BANKER or TIE. There is nothing to decide once the cards come out: the dealer draws by the tableau, closest to nine wins. The Banker wins a little more often, so a Banker win on a three-card 7 only pushes."
	]
	"quest.687565AB514EEF81.title": "A Natural"
	"quest.687565AB514EEF81.quest_subtitle": "Eight or nine on two cards."
	"quest.687565AB514EEF81.quest_desc": [
		"Win a coup that was settled by a natural: an 8 or a 9 on the first two cards, where nobody draws. It is over before a third card can save anyone, and the whole table sees it land on the felt at once."
	]
	"quest.67F72F29FA3BC607.title": "Krampus and the Polar Bear"
	"quest.67F72F29FA3BC607.quest_subtitle": "The side bets."
	"quest.67F72F29FA3BC607.quest_desc": [
		"The red 7 wins forty to one when the Banker wins on three cards to 7; the white 8 wins twenty-five to one when the Player wins on three cards to 8. Win either. They come up about once in forty coups."
	]
	"quest.45A920982B16572E.title": "Jacks or Better"
	"quest.45A920982B16572E.quest_subtitle": "Hold, then draw."
	"quest.45A920982B16572E.quest_desc": [
		"Put up to five coins in a Video Poker cabinet, pull the lever, press the brass keys under the cards you keep and pull again. Win any paying hand. Five coins is the full return: the royal pays 800 a coin there."
	]
	"quest.45F2F984A25678EA.title": "Four of a Kind"
	"quest.45F2F984A25678EA.quest_subtitle": "Twenty-five a coin."
	"quest.45F2F984A25678EA.quest_desc": [
		"Draw four of a kind (or better) at Video Poker. It comes about once in four hundred hands with good holds: keep every pair, never a kicker, and let the flaps riffle. Four of a kind pays twenty-five a coin."
	]
	"reward.3217CA0B1A1ED90E.title": "Fireworks!"
	"quest.3D5AAD87F5A0BC70.title": "The Royal"
	"quest.3D5AAD87F5A0BC70.quest_subtitle": "Ten to ace, one suit."
	"quest.3D5AAD87F5A0BC70.quest_desc": [
		"Draw a royal flush: ten, jack, queen, king and ace of one suit. About one hand in forty thousand, so it is a story people will hear about all season. At five coins it pays 4,000 of them."
	]
	"reward.70A4379119D5653F.title": "Fireworks!"
	"quest.1ABB42B4520AF9CC.title": "The North Pole Jackpot"
	"quest.1ABB42B4520AF9CC.quest_subtitle": "It must drop before 5,000."
	"quest.1ABB42B4520AF9CC.quest_desc": [
		"Every real chip staked on Jingle Reels or Video Poker puts two in a hundred into one pot for the whole server, and the meters roll it up. It must drop before 5,000, at a point sealed when it starts: be the spin or the hand that carries it there."
	]
	"quest.65BCB7C6DA9DFD52.title": "They're Off"
	"quest.65BCB7C6DA9DFD52.quest_subtitle": "Back the right reindeer."
	"quest.65BCB7C6DA9DFD52.quest_desc": [
		"Put chips on a runner's roundel at the Reindeer Derby, then press START or wait for the gate. The odds are on the tote, the order is drawn at the gate, and the chains under the track carry it home. Win a race."
	]
	"quest.54C7CF4D81CE9164.title": "The Long Shot"
	"quest.54C7CF4D81CE9164.quest_subtitle": "Twelve to one or longer."
	"quest.54C7CF4D81CE9164.quest_desc": [
		"Win backing a runner at 12-1 or longer. The long shots win less often than the favourites, but every bet on the card returns the same in the long run: the difference is the story."
	]
	"quest.233AAF32706D7F1B.title": "The Baccarat Table"
	"quest.233AAF32706D7F1B.quest_subtitle": "Five seats, eight decks."
	"quest.233AAF32706D7F1B.quest_desc": [
		"Print a baccarat layout on the Workshop Press (felt, red and black ink, blue dye) and lay it, with two decks for the eight-deck shoe, on a large blackjack frame of pieces: the cloth makes it baccarat. Power the shoe and seat a dealer."
		""
		"{image:cccasino:textures/gui/quest/mb_baccarat_table.png width:200 height:78 align:center}"
	]
	"quest.4FF3E69EE26E2A8C.title": "A Cabinet of Your Own"
	"quest.4FF3E69EE26E2A8C.quest_subtitle": "Five flaps on one axle."
	"quest.4FF3E69EE26E2A8C.quest_desc": [
		"Varnished card leaves, iron and a press ride a sequenced line round a precision mechanism five times to make the flap card bank. The Workshop builds it into a Split-Flap Screen: stand it on a Cabinet Plinth and run a shaft into the plinth's back."
		""
		"{image:cccasino:textures/gui/quest/mb_video_poker.png width:200 height:78 align:center}"
	]
	"quest.794A08662876BB40.title": "Roll It Up"
	"quest.794A08662876BB40.quest_subtitle": "Five drums and a bell."
	"quest.794A08662876BB40.quest_desc": [
		"Spin copper drums on the Workshop Lathe and print their digits on the Press. Two Counter Drum Banks either side of a Jackpot Bell Drive make the meter. Seat it on a bank of cabinets: every meter shows the same pot."
		""
		"{image:cccasino:textures/gui/quest/mb_jackpot_meter.png width:200 height:78 align:center}"
	]
	"quest.4E5304ECD7C6AE5F.title": "The Reindeer Derby"
	"quest.4E5304ECD7C6AE5F.quest_subtitle": "Six runners and a tote."
	"quest.4E5304ECD7C6AE5F.quest_desc": [
		"Lay a Start Gate, eight Derby Track Segments and the Starter's Box with its tote of six Create display boards. Turn six birch reindeer on the Lathe, blanket them on the Loom, number them on the Press and lead them into the Start Gate. A shaft up into the Starter's Box runs the chains."
		""
		"{image:cccasino:textures/gui/quest/mb_reindeer_derby.png width:200 height:78 align:center}"
	]
	"reward.7DBB11749BED1860.title": "Fireworks!"
	"quest.22F01DA66DD51A33.title": "The Full Floor"
	"quest.22F01DA66DD51A33.quest_subtitle": "Every game in the house."
	"quest.22F01DA66DD51A33.quest_desc": [
		"A baccarat table, a Video Poker cabinet under a jackpot meter, and the Reindeer Derby, all of your own making. The North Pole has a casino floor to rival anywhere."
	]
	"quest.50C1DFAAE00DF7F8.title": "High Roller"
	"quest.50C1DFAAE00DF7F8.quest_subtitle": "Ten thousand. In one chip."
	"quest.50C1DFAAE00DF7F8.quest_desc": [
		"Hold a ten thousand chip. Very few people on the server ever will. Whether you built it up slowly or won it in a night, you are now the person everyone watches at the table."
	]
	"chapter.185CCFBD33A4DEFF.title": "The Create Kitchen"
	"chapter.185CCFBD33A4DEFF.chapter_subtitle": [
		"Let the machines do the cooking."
	]
	"quest.104CDB77A0213D10.title": "Egg Yolk on Tap"
	"quest.104CDB77A0213D10.quest_subtitle": "A roost, a drain, and no more cracking."
	"quest.104CDB77A0213D10.quest_desc": [
		"Catch a chicken with an empty roost (or lead it in) and it lays without wandering off; feed it seeds by belt or arm and it lays faster. Roll the eggs over an item drain: each gives 250 mB of yolk and a shell. Yolk goes into cake batter, salty dough, fish fillets and fried rice."
	]
	"quest.4BFBB952CD9B7A3A.title": "The Dairy"
	"quest.4BFBB952CD9B7A3A.quest_subtitle": "Milk in the pipes, butter in the basin."
	"quest.4BFBB952CD9B7A3A.quest_desc": [
		"Half the kitchen runs on milk. Pen some cows (a deployer holding a bucket can milk them for you) and drain the buckets into a tank with an item drain. Then churn: a heated mixer turns 500 mB of milk into a block of butter. Cake batter, krokets, cheese and the hotcake stack all drink from this tank."
	]
	"quest.561494267C89033E.title": "Autonomous Bee-Keeping"
	"quest.561494267C89033E.quest_subtitle": "Let the bees fill the tank."
	"quest.561494267C89033E.quest_desc": [
		"Run a pipe into a beehive and pump: when the hive is full, the honey flows out as a fluid. A few hives by a flower bed keep a tank topped up with no bottles and no stings. Honey glazes apples, sweetens stroopwafel dough and crowns the hotcake stack."
	]
	"quest.0C91B1F3D7CA477C.title": "Balanced Diet"
	"quest.0C91B1F3D7CA477C.quest_subtitle": "One spout, three fluids, three treats."
	"quest.0C91B1F3D7CA477C.quest_desc": [
		"Make chocolate in a heated mixer from sugar, cocoa beans and 250 mB of milk. Then feed one spout from your milk, honey and chocolate tanks in turn: milk on bread for a sweet roll, honey on an apple, chocolate on sweet berries. The advancement only counts if all three come from the same spout."
	]
	"quest.752B3FBA592B0F14.title": "Eggnog on Tap"
	"quest.752B3FBA592B0F14.quest_subtitle": "Milk, eggs, sugar, no heat."
	"quest.752B3FBA592B0F14.quest_desc": [
		"Mix 500 mB of milk, two eggs and a spoon of sugar in an unheated basin: out comes 500 mB of eggnog. Pipe it to a tank and let a spout fill glass bottles as they ride past, 250 mB a bottle. The Food Drive will want it by the crate, so build it to run."
	]
	"quest.0AF1029F15061223.title": "Flour Power"
	"quest.0AF1029F15061223.quest_subtitle": "Every bakery starts at the millstone."
	"quest.0AF1029F15061223.quest_desc": [
		"Wheat through a millstone makes flour, the start of dough, batter, breadcrumbs and pie crust. A thresher can split wheat into kernels first, which mill into flour too. A wheat field feeding a millstone is the first thing any good kitchen builds."
	]
	"quest.1965E573A01EE776.title": "Knead It"
	"quest.1965E573A01EE776.quest_subtitle": "The mixer does the kneading."
	"quest.1965E573A01EE776.quest_desc": [
		"Flour and 1000 mB of water in a mixer make dough, with no crafting at all. A fan blowing through fire bakes it into bread; honey from a spout turns it into stroopwafel dough. Pipe water to the basin and the dough keeps coming."
	]
	"quest.093AA491ABBCBEC2.title": "Into the Oven"
	"quest.093AA491ABBCBEC2.quest_subtitle": "Heat from below, air from the sides."
	"quest.093AA491ABBCBEC2.quest_desc": [
		"Stack oven blocks into one oven, set a blaze burner beneath it and powered oven fans on its walls. Heat and airflow together set its level, and goggles show it. It runs every smoker recipe in bulk: bread, baked moulds, sausages, cocoa beans. Build one; the cake quest proves it bakes."
	]
	"quest.6FE8EBBC7B4F346D.title": "Let Them Eat Cake"
	"quest.6FE8EBBC7B4F346D.quest_subtitle": "Batter, mould, oven, demolder."
	"quest.6FE8EBBC7B4F346D.quest_desc": [
		"Press three iron sheets into a cake mould. Mix two flour, sugar, 250 mB of egg yolk and 250 mB of milk into a bucket of batter, spout 500 mB into the mould and bake it in the oven. A mechanical demolder turns out the cake base and sends the mould back round to be filled again."
	]
	"quest.43A7DF1AD52C0CAD.title": "Stroopwafel Stand"
	"quest.43A7DF1AD52C0CAD.quest_subtitle": "Honey dough, pressed, glazed, wrapped."
	"quest.43A7DF1AD52C0CAD.quest_desc": [
		"Spout 125 mB of honey onto dough for sweet dough and press it flat. Bake it in a fan's smoke, spout 250 mB of chocolate over the top, and let a deployer wrap it in paper. Six stations on one belt, and the first line here that runs from dough to wrapper."
	]
	"reward.26C62C4DDE2CB078.title": "Fireworks!"
	"quest.751CBF16A31DFFF7.title": "The Hotcake Stack"
	"quest.751CBF16A31DFFF7.quest_subtitle": "Ten machines for one breakfast."
	"quest.751CBF16A31DFFF7.quest_desc": [
		"Saw a cake mould into a burger-bun mould, then into a pancake mould. Spout batter into it, bake it and demould a pancake. Then a sequenced line deploys two more pancakes and a block of butter onto it and spouts 100 mB of honey on top. This is the bakery at full steam."
	]
	"quest.397326F2B72A0AAB.title": "The Thresher"
	"quest.397326F2B72A0AAB.quest_subtitle": "Separate the good from the chaff."
	"quest.397326F2B72A0AAB.quest_desc": [
		"A thresher on a belt strips what passes through it: wheat into kernels, sunflowers into seeds, dried cocoa beans into nibs, and any stone into boil stone for salt. Half the kitchen's ingredients start here. Thresh some stone."
	]
	"quest.19AA7CB7279E702E.title": "Bean to Butter"
	"quest.19AA7CB7279E702E.quest_subtitle": "The chocolatier's secret."
	"quest.19AA7CB7279E702E.quest_desc": [
		"Dry cocoa beans in a fan's smoke or the oven, then thresh them into nibs. A heated mixer melts the nibs into cocoa liquor, and an unheated mix splits the liquor into cocoa solids and, three times in four, cocoa butter. A millstone grinds the solids into cocoa powder. Real chocolate starts here."
	]
	"quest.3DFFD8787102662E.title": "Bean to Bar"
	"quest.3DFFD8787102662E.quest_subtitle": "Moulded, frozen, turned out."
	"quest.3DFFD8787102662E.quest_desc": [
		"Mix cocoa solids, cocoa butter and sugar in a heated mixer for chocolate. Press two iron sheets into a chocolate mould, spout 250 mB into it and drop it on a frozen block to set. A mechanical demolder turns out the bar and sends the mould back round."
	]
	"quest.36624FA4AD153B0A.title": "Death by Chocolate"
	"quest.36624FA4AD153B0A.quest_subtitle": "Bean to cake."
	"quest.36624FA4AD153B0A.quest_desc": [
		"Spout 500 mB of chocolate over a cake base. It sounds simple, but the chocolate came from beans you dried, threshed and mixed, and the base from a mould you pressed, filled, baked and demoulded. Two whole lines, one cake. Honey instead of chocolate makes a honey cake."
	]
	"quest.0C4D9B0740374914.title": "Worth Its Salt"
	"quest.0C4D9B0740374914.quest_subtitle": "Every recipe needs a pinch."
	"quest.0C4D9B0740374914.quest_desc": [
		"Boil stone in a heated mixer with 250 mB of water leaves salt behind, and the stone comes back to use again. Salt goes into mince meat, cheese, salty dough, fish fillets and the secret seasoning. Loop the boil stone back to the basin and it never runs out."
	]
	"quest.47E3C75BB8E7B4C4.title": "The Fry Shop"
	"quest.47E3C75BB8E7B4C4.quest_subtitle": "Hot oil, all day long."
	"quest.47E3C75BB8E7B4C4.quest_desc": [
		"Thresh sunflowers for seeds and press them in a basin: 100 mB of oil each. Peel potatoes in a drum processor with sand, saw them into sticks, and ride them through a continuous fryer over a blaze burner at 125 mB of oil a portion. Any cooking oil works; run dry and the line stops."
	]
	"quest.15303E2461DFE49D.title": "Golden and Crispy"
	"quest.15303E2461DFE49D.quest_subtitle": "The first fried drumstick."
	"quest.15303E2461DFE49D.quest_desc": [
		"Craft the secret seasoning (flour, beetroot, dried kelp, salt and onion; a mechanical crafter can do it). A mixer seasons a raw chicken into a battered drumstick and keel. Mill bread into breadcrumbs, let a drum processor coat the pieces, then fry them golden."
	]
	"quest.14B33F2E980204B3.title": "Christmas Fried Chicken"
	"quest.14B33F2E980204B3.quest_subtitle": "In Japan, this is Christmas dinner."
	"quest.14B33F2E980204B3.quest_desc": [
		"Press pulp into cardboard and send it down a sequenced line: deployers add a drumstick, then a keel, twice round. In Japan a bucket of fried chicken is the Christmas meal, and the Feast wraps this one into the Christmas Party Bucket."
	]
	"quest.4F244DA1C9B323B2.title": "Fillet-o-Fish"
	"quest.4F244DA1C9B323B2.quest_subtitle": "From the net to the fryer."
	"quest.4F244DA1C9B323B2.quest_desc": [
		"Put a fishing net on a contraption that moves through water. Mix the catch with salt and 250 mB of egg yolk into a raw fillet, coat it in breadcrumbs in the drum processor and fry it. Net, mixer, drain, millstone, drum and fryer, all in one sandwich."
	]
	"quest.42862071A78ABF3C.title": "Doughnut Run"
	"quest.42862071A78ABF3C.quest_subtitle": "Tumbled, fried, dipped."
	"quest.42862071A78ABF3C.quest_desc": [
		"Mix flour, salt and 100 mB of egg yolk into salty dough. The drum processor tumbles it with butter into a ring, the fryer turns the ring into a doughnut, and a spout dips it in 250 mB of chocolate. Three machines you already own, one new sweet."
	]
	"quest.308AB79126E02A54.title": "The Snack Bar"
	"quest.308AB79126E02A54.quest_subtitle": "Deep-fried, on bread, with both sauces."
	"quest.308AB79126E02A54.quest_desc": [
		"Mix beef, two flour and 250 mB of milk into a raw kroket and deep-fry it in a mechanical fryer: a head over a basin of oil, heated by a blaze burner. A deployer lays it on bread. Mix ketchup hot (sugar, milled nether wart, tomatoes, water) and mayonnaise cold (three eggs, milk), then spout both on."
	]
	"quest.5D169C350172042A.title": "The Sausage Line"
	"quest.5D169C350172042A.quest_subtitle": "Mince, case, squeeze, smoke."
	"quest.5D169C350172042A.quest_desc": [
		"Mix raw meat and salt into mince. Saw slime balls into casings, and fill each casing with 250 mB of mince in a squeeze basin. Smoke the raw sausage, then a deployer lays it in bread. Compost kelp, salt and water into slime and the casings never run out."
	]
	"quest.1872715D300C1F81.title": "The Basin Is a Pot"
	"quest.1872715D300C1F81.quest_subtitle": "A hundred and fifty recipes, no stirring."
	"quest.1872715D300C1F81.quest_desc": [
		"Most cooking-pot recipes also work in a basin over a blaze burner: ingredients and bowl go in together and the mixer cooks. Make fried rice from rice, a carrot, an onion, a bowl and 250 mB of egg yolk. A pot on a burner, fed by a mechanical arm, works too."
	]
	"quest.6FF29D5D06B3C901.title": "Soup by the Tank"
	"quest.6FF29D5D06B3C901.quest_subtitle": "Ladle it out with a spout."
	"quest.6FF29D5D06B3C901.quest_desc": [
		"A heated basin turns raw beef, a carrot and a potato into 333 mB of beef stew, or carrot, potato, beetroot and cabbage into vegetable soup. Pipe it to a tank; a spout fills a bowl from every 333 mB. Fill a bucket from the tank to prove the soup flows. The soup kitchen runs on this."
	]
	"quest.78524E3605A2C3CD.title": "Dinner on a Belt"
	"quest.78524E3605A2C3CD.quest_subtitle": "Six stations, one shepherd's pie."
	"quest.78524E3605A2C3CD.quest_desc": [
		"A bowl rides a sequenced line: deployers add two cooked mutton, a baked potato and an onion, then a spout pours on 250 mB of milk. Out comes a whole shepherd's pie. Roast chicken, apple pie and twenty more dinners assemble the same way; JEI lists them."
	]
	"quest.41DAAB6F39C06A5A.title": "The Cider Press"
	"quest.41DAAB6F39C06A5A.quest_subtitle": "Four apples, one press."
	"quest.41DAAB6F39C06A5A.quest_desc": [
		"Press four apples in a basin for 500 mB of apple cider, or heat two apples, sugar and water in a mixer. Pipe the cider to a tank and spout it into bottles, 250 mB each. The Feast spices it into mulled cider, so keep the press running."
	]
	"quest.3258FD8B6F67A9D6.title": "The Cellar"
	"quest.3258FD8B6F67A9D6.quest_subtitle": "Some things cannot be hurried."
	"quest.3258FD8B6F67A9D6.quest_desc": [
		"A keg ferments drinks from a base fluid and a few ingredients: wheat, seeds and a brown mushroom on 1000 mB of water make beer. Pipes can fill a keg and empty it, and a spout pours it into tankards. Ferment your first drink and start a cellar."
	]
	"quest.6365D13CA1516F04.title": "Say Cheese"
	"quest.6365D13CA1516F04.quest_subtitle": "Ferment it, then wait."
	"quest.6365D13CA1516F04.quest_desc": [
		"Pipe 1000 mB of milk into a keg with a pinch of salt and keep it warm, with a heat source beside it, for an unripe cheese wheel. Age it in a cask for a minute or so. Arms and packagers can load the cask, and a wheel left in longer becomes Aged, Fine, then Reserve."
	]
	"quest.6E6A527CAA03C0A2.title": "Harvest Day"
	"quest.6E6A527CAA03C0A2.quest_subtitle": "Every ripe crop, all at once."
	"quest.6E6A527CAA03C0A2.quest_desc": [
		"A vacuum harvester charges up on rotation, then pulls in every mature crop around it in one go and keeps them inside for a funnel to take. Build it from a mechanical harvester, a fan, brass casing and a chute, and the fields feed the kitchen on their own."
	]
	"chapter.7F369D70FE74A142.title": "A Christmas Feast"
	"chapter.7F369D70FE74A142.chapter_subtitle": [
		"Sweets, drinks and the big dinner."
	]
	"quest.36281AD7B202F696.title": "The Christmas Pantry"
	"quest.36281AD7B202F696.quest_subtitle": "Icing sugar, peppermint, holly."
	"quest.36281AD7B202F696.quest_desc": [
		"Three things every Christmas recipe here starts from. Mill sugar into icing sugar and candy canes into crushed peppermint, and craft holly sprigs from sweet berries and leaves. Keep a millstone on each and the whole menu opens up."
	]
	"quest.218B55EFD010CFEC.title": "Christmas Cookies"
	"quest.218B55EFD010CFEC.quest_subtitle": "Stars, iced, by the tray."
	"quest.218B55EFD010CFEC.quest_desc": [
		"Mix two flour, sugar, butter and an egg into four cookie dough, and press each dough into two stars. Bake them in a fan's smoke or an oven. Mix two icing sugar with 100 mB of milk for icing, and a spout ices each cookie with 50 mB. Sneak to set one down: a plate holds four."
	]
	"quest.4A21F4609A9463F1.title": "Gingerbread Men"
	"quest.4A21F4609A9463F1.quest_subtitle": "Pressed, not cut."
	"quest.4A21F4609A9463F1.quest_desc": [
		"Gingerdough is sugar, cinder flour, wheat flour and 250 mB of honey, mixed. Cinder flour comes from crushing netherrack between crushing wheels. A press over a belt stamps each dough into a gingerbread man; an oven or a fan's smoke bakes plain gingerbread instead."
	]
	"quest.1D97EFF2528F8063.title": "A Gingerbread House"
	"quest.1D97EFF2528F8063.quest_subtitle": "Every village needs one."
	"quest.1D97EFF2528F8063.quest_desc": [
		"Four gingerdough make a gingerbread block; four blocks make bricks, and a stonecutter turns them into stairs and slabs. Candy canes make candy cane blocks for the corners, and a press compacts sugar with dye fluid into gumdrops for the roof. Build a real house, with a lit window."
	]
	"quest.4D56E6D890C10155.title": "Peppermint Bark"
	"quest.4D56E6D890C10155.quest_subtitle": "Two chocolates, peppermint, a saw."
	"quest.4D56E6D890C10155.quest_desc": [
		"Heat sugar, cocoa butter and 250 mB of milk for white chocolate. On a sequenced line a chocolate bar takes 250 mB of white chocolate from a spout, crushed peppermint from a deployer and a firm press. A saw cuts each slab into four pieces for the Christmas tin."
	]
	"quest.273FFFA1BD6ED44E.title": "Mince Pies"
	"quest.273FFFA1BD6ED44E.quest_subtitle": "One for Santa's plate."
	"quest.273FFFA1BD6ED44E.quest_desc": [
		"Heat two apples, two raisins, sugar, ginger and butter into 500 mB of mincemeat. Mix flour, sugar and butter into puff pastry and press it into cases. A sequenced line spouts 100 mB of mincemeat, lids it with pastry and crimps it. Bake, then a deployer dusts on icing sugar."
	]
	"quest.0381E588199B1136.title": "The Yule Log"
	"quest.0381E588199B1136.quest_subtitle": "Rolled, barked, crowned with holly."
	"quest.0381E588199B1136.quest_desc": [
		"A cake base from the kitchen's mould rides a sequenced line: 250 mB of chocolate from a spout, rolled under a press, barked with cocoa powder (milled cocoa solids) and crowned with holly. It sets down as a feast of four slices. Sneak with an empty hand to pick it up whole."
	]
	"quest.7FD24F3D2D6988BB.title": "Christmas Pudding, Alight"
	"quest.7FD24F3D2D6988BB.quest_subtitle": "Steamed, crowned, set on fire."
	"quest.7FD24F3D2D6988BB.quest_desc": [
		"Heat two flour, two raisins, sugar, an egg, butter and 100 mB of honey into pudding batter, and spout 250 mB into a bowl. Steam it in a fan blowing through water, crown it with holly, then a fan blowing through lava sets it alight. It arrives at the table flaming."
	]
	"quest.6EC26317596FD2F4.title": "Mulled Cider"
	"quest.6EC26317596FD2F4.quest_subtitle": "The carollers' favourite."
	"quest.6EC26317596FD2F4.quest_desc": [
		"Craft Christmas mugs from two bricks and red dye. Heat two apples, sugar and 250 mB of water for cider (any mod's cider works), then heat 500 mB with ginger and sugar into mulled cider. Pipe it to a tank, and a spout fills a mug with 250 mB as each one rolls past."
	]
	"quest.0525945AE95A8C79.title": "Wassail"
	"quest.0525945AE95A8C79.quest_subtitle": "Wassail! Wassail! All over the town."
	"quest.0525945AE95A8C79.quest_desc": [
		"Mix sugar, two oranges and 250 mB of water for orange juice. Then heat 250 mB of mulled cider, 250 mB of orange juice, a cranberry and a honey bottle into wassail, and fill mugs from the same spout. It is the strongest drink on the menu: regeneration and resistance."
	]
	"quest.41E65FB3CFA71618.title": "Gingerbread Latte"
	"quest.41E65FB3CFA71618.quest_subtitle": "For the night shift."
	"quest.41E65FB3CFA71618.quest_desc": [
		"Heat two coffee beans with 250 mB of water for coffee. Heat that with 250 mB of milk, ginger and sugar for the latte base, and spout it into a mug. Two minutes of haste per cup, so keep a tank of it beside the workshop."
	]
	"quest.1D3F0EA276A1FF03.title": "Peppermint Hot Chocolate"
	"quest.1D3F0EA276A1FF03.quest_subtitle": "Cocoa, made properly."
	"quest.1D3F0EA276A1FF03.quest_desc": [
		"Mill cocoa solids into cocoa powder, and heat sugar, two powder and 250 mB of milk for hot chocolate; any mod's hot cocoa fluid also works. Heat 250 mB with crushed peppermint for peppermint cocoa, and spout it into a mug."
	]
	"quest.625FF1E0791A1A67.title": "The Deluxe"
	"quest.625FF1E0791A1A67.quest_subtitle": "Marshmallows. A candy cane. Perfection."
	"quest.625FF1E0791A1A67.quest_desc": [
		"Heat two sugar, a slime ball and 250 mB of water for eight marshmallows; with a mundane potion instead of water you get four candy canes. On a sequenced line a mug takes 250 mB of hot chocolate, a marshmallow and a candy cane. The North Pole's finest drink."
	]
	"quest.3A6B51BCBD69EBCD.title": "Punch and Milkshakes"
	"quest.3A6B51BCBD69EBCD.quest_subtitle": "Something cold for the children's table."
	"quest.3A6B51BCBD69EBCD.quest_desc": [
		"Heat a lemon slice, sugar and four cranberries for cranberry jam, then mix 250 mB of it cold with 250 mB of orange juice, ice and sugar for punch. Saw ice into cubes, mix two with sugar and 500 mB of milk for ice cream base, then add milk and peppermint and pour it into a tall cup."
	]
	"quest.165F13210E83C72D.title": "Roast Potatoes"
	"quest.165F13210E83C72D.quest_subtitle": "Crispy outside, fluffy inside."
	"quest.165F13210E83C72D.quest_desc": [
		"Baked potatoes ride through the fryer in 125 mB of any cooking oil and come out as two portions of roast potatoes. Bake the potatoes in an oven or a fan's smoke on the way in, and the whole line runs from the potato farm."
	]
	"quest.5713C778265B627E.title": "Pigs in Blankets"
	"quest.5713C778265B627E.quest_subtitle": "Sausages, wrapped in bacon."
	"quest.5713C778265B627E.quest_desc": [
		"Any raw meat crafts into a raw sausage, and a knife or a Slice and Dice slicer cuts porkchops into bacon. A deployer wraps the bacon round each sausage, then a fan's smoke cooks them through. Everyone takes one more than their share."
	]
	"quest.16B3C5D39B428563.title": "Stuffing and Gravy"
	"quest.16B3C5D39B428563.quest_subtitle": "The trimmings make the dinner."
	"quest.16B3C5D39B428563.quest_desc": [
		"Mill bread into breadcrumbs, and heat two breadcrumbs with an onion and an egg for two stuffing. In a second basin heat flour, raw beef and 500 mB of water into gravy, and pipe it into a tank beside the platter line. The platter takes 250 mB."
	]
	"quest.2DED4D36DD880F59.title": "The Christmas Ham"
	"quest.2DED4D36DD880F59.quest_subtitle": "Honey-glazed, on a bed of rice."
	"quest.2DED4D36DD880F59.quest_desc": [
		"Smoke a ham from a pig. On a sequenced line, cooked rice takes the smoked ham, sweet berries and 250 mB of honey from a spout, and comes off as a whole honey-glazed ham to carve at the table. The same kind of line roasts a chicken: a bowl, then six deployers."
	]
	"reward.172441F3FDBB073A.title": "Fireworks!"
	"quest.47CA656304C804DD.title": "Christmas Dinner"
	"quest.47CA656304C804DD.quest_subtitle": "The whole table, on one platter."
	"quest.47CA656304C804DD.quest_desc": [
		"Start from a roast chicken off a sequenced line, then deploy roast potatoes, pigs in blankets and stuffing, and spout 250 mB of gravy and 100 mB of cranberry jam (heated lemon, sugar and cranberries). Five stations, three supply lines, one four-serving feast."
	]
	"quest.11F5DC58C84D39B9.title": "The Christmas Party Bucket"
	"quest.11F5DC58C84D39B9.quest_subtitle": "Wrapped, with fries and cake."
	"quest.11F5DC58C84D39B9.quest_desc": [
		"Take a bucket of fried chicken from the kitchen and send it down a sequenced line: deployers wrap it in red wrapping paper, add fries and add a slice of cake. Cut a cake into slices with a knife or a Slice and Dice slicer. It feeds a whole team after a long build."
	]
	"quest.584718B49E37049D.title": "Set the Table"
	"quest.584718B49E37049D.quest_subtitle": "Plates, mugs and somewhere to sit."
	"quest.584718B49E37049D.quest_desc": [
		"Sneak to set a dish down. Cookies and mince pies stack four to a plate, a mug stands on the table until someone drinks it, and a feast serves four before the plate is empty. Many other mods' dishes can be set down too, and food plates from wooden slabs hold the plated ones. Lay four places."
	]
	"reward.45C9B17D9D040E53.title": "Fireworks!"
	"quest.3E893C6D585F9DD2.title": "The Christmas Table"
	"quest.3E893C6D585F9DD2.quest_subtitle": "Everything on the table at once."
	"quest.3E893C6D585F9DD2.quest_desc": [
		"A Christmas dinner platter, a flaming pudding and a Yule log, all on the table at once: three feasts, twelve servings, with cookies, mince pies and mugs between them. Set it all down, then call everyone in for dinner. Merry Christmas."
	]
	"task.723DF24FCA28DA84.title": "Deliver 12 iced cookies a minute for 3 minutes"
	"quest.6FDD05866923EE81.title": "Cookie Conveyor"
	"quest.6FDD05866923EE81.quest_subtitle": "Twelve iced cookies a minute."
	"quest.6FDD05866923EE81.quest_desc": [
		"Mixer, press, fan, spout: twelve iced cookies a minute for three minutes, into a North Pole Tally. Every stage has to keep up with the next, so you find out exactly where your line is slow. Two presses on one belt usually fix it."
	]
	"task.3EA739BD0E899744.title": "Deliver 10 mugs of mulled cider a minute for 5 minutes"
	"quest.3F2DFDA4FFC01484.title": "Cider on Tap"
	"quest.3F2DFDA4FFC01484.quest_subtitle": "Ten mugs a minute."
	"quest.3F2DFDA4FFC01484.quest_desc": [
		"Ten mugs of mulled cider a minute for five minutes. Cider in, spice in, heat on, and a spout filling mugs as fast as the belt brings them. A tank between the basin and the spout keeps the line running while the mixer works."
	]
	"task.2AE0FAB217F0ACB3.title": "Deliver 6 mince pies a minute for 5 minutes"
	"reward.78C76BD11691E75E.title": "Fireworks!"
	"quest.0A7B6AF59AD4B18A.title": "Mince Pie Production"
	"quest.0A7B6AF59AD4B18A.quest_subtitle": "Six pies a minute."
	"quest.0A7B6AF59AD4B18A.quest_desc": [
		"Six mince pies a minute for five minutes: mincemeat, pastry, a sequenced line, an oven and a dusting of sugar, all in time. Run two sequenced lines side by side off one mincemeat tank. Santa will notice."
	]
	"task.7B75F1F1A7C6478B.title": "Deliver 2 Christmas party buckets a minute for 5 minutes"
	"reward.4E5E22832A2F17B7.title": "Fireworks!"
	"quest.26C1493987D0BABB.title": "The Christmas Rush"
	"quest.26C1493987D0BABB.quest_subtitle": "Two party buckets a minute."
	"quest.26C1493987D0BABB.quest_desc": [
		"Two Christmas party buckets a minute for five minutes. Fried chicken, wrapping paper, fries and cake, all arriving on time. Build this and you are running the busiest kitchen at the North Pole."
	]
	"chapter.39D6EA83EC71F3F6.title": "The Food Drive"
	"chapter.39D6EA83EC71F3F6.chapter_subtitle": [
		"Nobody goes hungry at Christmas."
	]
	"quest.09D4946D3A53AAD9.title": "The Food Drive"
	"quest.09D4946D3A53AAD9.quest_subtitle": "Nobody goes hungry at Christmas."
	"quest.09D4946D3A53AAD9.quest_desc": [
		"The North Pole has a pantry to fill before Christmas. Put down a cooking pot and the Food Drive opens. Its stalls take food every day and open again the next: bring what your farms and kitchens make, and the better the food, the better the thanks."
	]
	"quest.426BD395781589F0.title": "Packed for Winter"
	"quest.426BD395781589F0.quest_subtitle": "Nine in, one crate out."
	"quest.426BD395781589F0.quest_desc": [
		"A mechanical press over a basin packs nine of anything into one: wheat into hay bales, potatoes and carrots into crates. Packed food stacks tight, rides a belt in a ninth of the space and is how the Drive's pantry likes it. Pack your first harvest."
	]
	"quest.2717ECAC505E7892.title": "The Pantry Restocks Itself"
	"quest.2717ECAC505E7892.quest_subtitle": "A supply line, not a shopping trip."
	"quest.2717ECAC505E7892.quest_desc": [
		"Point a factory gauge at your packed food and let it order its own top-ups: when the crates run low, packages leave the farm, ride the chain and land in the pantry. Set it up once and the Drive's stalls never wait on you again."
	]
	"quest.19C3F2C1A2E9B511.title": "A Glorious Feast"
	"quest.19C3F2C1A2E9B511.quest_subtitle": "Big enough to share."
	"quest.19C3F2C1A2E9B511.quest_desc": [
		"Some meals are placed on the table and served by the bowl. A sequenced line of deployers builds a roast chicken: chicken, baked potato, carrot, onion, egg and bread on a bowl. Put one down, and the Drive's feast and Christmas stalls open."
	]
	"reward.10C053D2A39A6F47.title": "Fireworks!"
	"quest.6456CD14975F13E0.title": "Every Dish on the Menu"
	"quest.6456CD14975F13E0.quest_subtitle": "Somebody has to taste it all."
	"quest.6456CD14975F13E0.quest_desc": [
		"Before anything goes out to the village, the Drive's cook tastes it. Eat one of each of Farmer's Delight's 27 meals: every stew, soup, pasta, salad and feast. A kitchen that can make all of them can feed anyone who knocks at the door."
	]
	"quest.5F312240B70F2CB0.title": "Fill the Granary"
	"quest.5F312240B70F2CB0.quest_subtitle": "Sixteen bales a day."
	"quest.5F312240B70F2CB0.quest_desc": [
		"Sixteen hay bales for the granary, every day. A wheat farm, a harvester and a press over a basin can do the lot without you. The bales are taken when you hand them in, and the stall opens again tomorrow."
	]
	"quest.13DF9A6DB4562743.title": "The Root Cellar"
	"quest.13DF9A6DB4562743.quest_subtitle": "Crates that keep all winter."
	"quest.13DF9A6DB4562743.quest_desc": [
		"Eight crates each of potatoes, carrots and onions for the root cellar. Three crops, one press: a filtered funnel sorts each crop to its own basin. The crates are taken on hand-in, and the cellar wants more tomorrow."
	]
	"quest.51B302B3A7D0FB85.title": "The Bread Line"
	"quest.51B302B3A7D0FB85.quest_subtitle": "Forty-eight loaves a day."
	"quest.51B302B3A7D0FB85.quest_desc": [
		"Forty-eight loaves for the bread line, every day. Mill wheat, mix dough with water and blow it through a fan's smoke: bread comes off the belt with nobody touching it. The loaves are taken, and the line forms again tomorrow."
	]
	"quest.7D89233F09399E37.title": "The Soup Kitchen"
	"quest.7D89233F09399E37.quest_subtitle": "Soup by the tank."
	"quest.7D89233F09399E37.quest_desc": [
		"Sixteen bowls of vegetable soup a day. A heated mixer turns carrots, potatoes, beetroot and cabbage into soup by the tank, and a spout fills a bowl from every 333 mB. Pipe it, bowl it, belt it to the stall."
	]
	"quest.44D34E07BF8EDB9F.title": "Warm Drinks for the Carollers"
	"quest.44D34E07BF8EDB9F.quest_subtitle": "Cocoa and eggnog, by the crate."
	"quest.44D34E07BF8EDB9F.quest_desc": [
		"Eight hot cocoas and eight eggnogs a day for the carollers and the Workshop's night shift. Both mix in a basin with 250 mB of milk and a bottle: cocoa beans and sugar over heat, egg and ginger cold. Pipe the milk in and they never stop."
	]
	"quest.0D7A3F7C9482CF16.title": "Pies in the Window"
	"quest.0D7A3F7C9482CF16.quest_subtitle": "Eight a day for the bakery."
	"quest.0D7A3F7C9482CF16.quest_desc": [
		"Eight apple pies for the bakery window, every day. A sequenced line lays apple, flour and sugar into a pie crust, twice round. An orchard, a wheat field and a sugar farm all have to feed it, so automate them before the snow gets deep."
	]
	"quest.26E4DEAAB2E16637.title": "Fried Chicken Friday"
	"quest.26E4DEAAB2E16637.quest_subtitle": "Every day is Friday at the Drive."
	"quest.26E4DEAAB2E16637.quest_desc": [
		"Four buckets of fried chicken a day. The seasoning, the batter, the breadcrumbs, the fryer and the bucket line all have to run together. A bucket feeds a whole team after a long shift, which is why the Drive pays well for it."
	]
	"quest.6A82BD2BA3F04AEB.title": "Hot Dogs at the Rink"
	"quest.6A82BD2BA3F04AEB.quest_subtitle": "Sixteen a day for the skaters."
	"quest.6A82BD2BA3F04AEB.quest_desc": [
		"The lake has frozen and the skaters are hungry. Sixteen hot dogs a day: mince, casing, squeeze, smoke, and a deployer lays each sausage in its bread. Keep the salt and the slime coming and the line never stalls."
	]
	"quest.2CBCFE0DD3F441A9.title": "Sunday Roasts"
	"quest.2CBCFE0DD3F441A9.quest_subtitle": "Feasts that feed four."
	"quest.2CBCFE0DD3F441A9.quest_desc": [
		"Two roast chickens and two shepherd's pies a day, each one a feast that serves four. Deployers lay the mutton, potato and onion, and a spout pours the milk. Two sequenced lines side by side make the whole order."
	]
	"quest.7AEE8E7F184871C2.title": "A Tin for Every Mantel"
	"quest.7AEE8E7F184871C2.quest_subtitle": "Sixteen iced cookies a day."
	"quest.7AEE8E7F184871C2.quest_desc": [
		"Every house in the village wants a plate out for Santa. Sixteen iced Christmas cookies a day, from now until Christmas Eve. Your cookie line already works; now it needs to run all evening."
	]
	"quest.5DB2C8BB0E34083D.title": "Mince Pies for the Carol Service"
	"quest.5DB2C8BB0E34083D.quest_subtitle": "Sixteen a day through Advent."
	"quest.5DB2C8BB0E34083D.quest_desc": [
		"The carol service runs every night in December, and every singer gets a mince pie. Sixteen a day: mincemeat, pastry, the sequenced line and a dusting of sugar, all running while you are out."
	]
	"quest.1DEBF1E02B20CBDA.title": "Mulled Cider in the Square"
	"quest.1DEBF1E02B20CBDA.quest_subtitle": "Sixteen mugs a day."
	"quest.1DEBF1E02B20CBDA.quest_desc": [
		"The square fills up every evening in December, and the cider has to keep pace. Sixteen mugs a day. Keep the tank hot and the mugs coming back from the wash, and the spout will do the rest."
	]
	"quest.43AF7E149A55796D.title": "Christmas Dinners for the Village"
	"quest.43AF7E149A55796D.quest_subtitle": "The best the Drive will see."
	"quest.43AF7E149A55796D.quest_desc": [
		"Two Christmas dinner platters and two Christmas party buckets a day: the biggest dishes in the North Pole, for the families who cannot make their own. It takes every line you have, so the Drive pays more for it than for anything else."
	]
	"chapter.4B4184B5EF1E544A.title": "Rails and Skies"
	"chapter.4B4184B5EF1E544A.chapter_subtitle": [
		"The North Pole is a long way from everywhere."
	]
	"quest.00754BCDE6C9641E.title": "Lay the First Mile"
	"quest.00754BCDE6C9641E.quest_subtitle": "Sleepers, nuggets and a press."
	"quest.00754BCDE6C9641E.quest_desc": [
		"Track is made on a sequenced line: a stone, smooth stone or andesite slab gets two iron or zinc nuggets from deployers, then a press. Make a stack. To lay it, click one track, then the spot where the line should end. Hold sprint for the widest curve; blocks in your off hand pave underneath."
	]
	"task.32AF803CCDA09DAD.title": "Make railway casing"
	"quest.5E16FB8B30A23365.title": "The Locomotive Age"
	"quest.5E16FB8B30A23365.quest_subtitle": "Sturdy sheets on brass."
	"quest.5E16FB8B30A23365.quest_desc": [
		"Crush obsidian between crushing wheels for powdered obsidian. On a sequenced line, spout 500 mB of lava onto the powder and press it twice: a sturdy sheet. Use a sturdy sheet on brass casing for railway casing. Stations, signals, bogeys and train controls are all built from it."
	]
	"quest.3376332F85C2BC37.title": "A Place to Stop"
	"quest.3376332F85C2BC37.quest_subtitle": "The waypoints of your network."
	"quest.3376332F85C2BC37.quest_desc": [
		"Railway casing and a compass make two stations. Hold one, click the track, then place it beside the line: the arrow shows the way trains pull in. Open it and give it a name. Put one at your base and one at the far end of your line. Everything after this runs between them."
	]
	"task.76F68D793D47C772.title": "Assemble a train at your station"
	"quest.09CBD509258B299C.title": "Your First Train"
	"quest.09CBD509258B299C.quest_subtitle": "Bogeys, glue and controls."
	"quest.09CBD509258B299C.quest_desc": [
		"Open the station and switch to Assembly Mode. Use railway casing on the first track past the station for a bogey. Build a carriage on it and super glue it all. Add train controls (casing, precision mechanism, lever) facing the way you will drive, and a seat. Then press Assemble."
	]
	"task.2BDCF762D4A36E49.title": "Blow a whistle while you drive"
	"quest.7CAB89688766184B.title": "Choo Choo!"
	"quest.7CAB89688766184B.quest_subtitle": "Take her out on the line."
	"quest.7CAB89688766184B.quest_desc": [
		"Right-click the controls to drive: W and S for speed, A and D choose the way at junctions, the mouse wheel sets top speed, and holding Space stops at the next station. A steam whistle on a fluid tank on board blows with sprint. Coal in a chest on board speeds the train up. Drive to your other station."
	]
	"task.76BDF76FC0469B57.title": "Give a train driver a schedule"
	"quest.27F2220CE80B6661.title": "Running on Time"
	"quest.27F2220CE80B6661.quest_subtitle": "Trains that drive themselves."
	"quest.27F2220CE80B6661.quest_desc": [
		"Paper and a sturdy sheet make four schedules. Write one: travel to your base, wait, travel to the far station, wait, and it repeats. A train needs a driver: any mob seated facing the controls, or a lit blaze burner in front of them. Hand the driver the schedule and step off."
	]
	"task.085A0E7311B96BA2.title": "Place a train signal"
	"quest.51693280A4AAD4C3.title": "Keep Them Apart"
	"quest.51693280A4AAD4C3.quest_subtitle": "Two trains, one track, no crashes."
	"quest.51693280A4AAD4C3.quest_desc": [
		"Railway casing and an electron tube make four signals; place them like a station. Signals cut the line into sections and let one train into each. A scheduled train never passes a signal from behind, so two-way track needs a pair facing both ways. Add a passing loop and two trains can share one line."
	]
	"task.1E1848A0DA7ADA1D.title": "Show a train arriving on a display board"
	"quest.2BB2356F641BC5C3.title": "Next Train Due"
	"quest.2BB2356F641BC5C3.quest_subtitle": "A departure board on the platform."
	"quest.2BB2356F641BC5C3.quest_desc": [
		"Run two scheduled trains on your line, kept apart by signals. Then let the platform tell you: a display link on the station, set to Train Station Summary, pointed at a display board on a turning shaft. When the board counts down to the next train, the network runs without you."
	]
	"task.45C4EF9770CDAFBA.title": "Load or unload a train through an interface"
	"quest.20C155A32104971C.title": "The Cargo Run"
	"quest.20C155A32104971C.quest_subtitle": "Freight without lifting a finger."
	"quest.20C155A32104971C.quest_desc": [
		"Put a portable storage interface on a wagon with chests behind it, and another on the platform one or two blocks away. When the train stops they connect, and funnels load or empty the whole wagon. Set the schedule to wait for Cargo Inactivity, and it leaves the moment the job is done."
	]
	"task.44F553DE01075976.title": "Assemble a train of six carriages"
	"quest.34F91E880290E840.title": "The North Pole Express"
	"quest.34F91E880290E840.quest_subtitle": "Six carriages long."
	"quest.34F91E880290E840.quest_desc": [
		"A carriage is whatever is glued onto its bogeys. Build several on the station track, each glued on its own with a gap between, and Assemble couples them into one train. Make it six carriages: an engine, coaches with seats for your friends, and wagons for the freight."
	]
	"task.7EBCAD45A1F2A7D9.title": "Fill an envelope with hot air"
	"quest.34E2BE43E500DA5A.title": "Lighter than Air"
	"quest.34E2BE43E500DA5A.quest_subtitle": "Hot air rises."
	"quest.34E2BE43E500DA5A.quest_desc": [
		"Wool and sticks make envelope; plain wool works too. Build an upside-down bowl at least 5 by 5, sealed on top and sides, open underneath. Set a hot air burner below the opening with clear air up to the roof, give it coal (no fuel, no lift) and power it with redstone. Goggles show the bag filling."
	]
	"quest.036D6D24A1A53AFB.title": "Keep the Fire Lit"
	"quest.036D6D24A1A53AFB.quest_subtitle": "A burner without fuel is a cold stove."
	"quest.036D6D24A1A53AFB.quest_desc": [
		"A burner burns fuel the whole time it is lit, hovering included. At full output a coal lasts 80 seconds, a coal block 13 minutes, a blaze rod 2. Feed it from a chest on board with a hopper, funnel or arm, never lava buckets. Two burners under one bag is a good first ship: make a second and lay in coal."
	]
	"task.7CD390C0E7FD730A.title": "Name your assembled airship with a nameplate"
	"quest.766A984F934C89CC.title": "Lift-Off"
	"quest.766A984F934C89CC.quest_subtitle": "Fill it first, then let go."
	"quest.766A984F934C89CC.quest_desc": [
		"Build a raft: a plank deck under your bag, the burners and a Physics Assembler on it. Glue it all. Fuel the burners, set the throttle low and wait about 30 seconds for the bag to fill, then hold right-click on the assembler and pull its lever. Ride up a few blocks and throttle back down. Name her with a nameplate on board."
	]
	"task.65463DB92074CD97.title": "Inspect a Contraption Diagram"
	"quest.1B2AFDBFD5032C34.title": "Measure Once, Fly Twice"
	"quest.1B2AFDBFD5032C34.quest_subtitle": "Weight under the balloon."
	"quest.1B2AFDBFD5032C34.quest_desc": [
		"Paper and a Physics Assembler make a Contraption Diagram. Use it on your ship and calculate its mass: the centre of mass must hang under the middle of the bag, or the ship flies tilted. Build light. Envelope and wool weigh a quarter, planks a half, stone 2, storage blocks 4: tooltips show each weight."
	]
	"task.5DA9A2877CCBB6EB.title": "Place an altitude sensor"
	"quest.4CF76919E2642343.title": "Up and Down"
	"quest.4CF76919E2642343.quest_subtitle": "The throttle is your altitude."
	"quest.4CF76919E2642343.quest_desc": [
		"A ship rises until lift equals weight, and air thins as you climb: one full burner lifts 750 at sea level, 600 at y 120. Wire a throttle lever to the burners before you fly. More signal climbs, less sinks, about ten seconds behind. An altitude sensor reads the air. Land on the throttle, never by running dry."
	]
	"task.7BACF4D5A57C949A.title": "Place and power a portable engine"
	"quest.517EE7AE88BA56A3.title": "Engine Room"
	"quest.517EE7AE88BA56A3.quest_subtitle": "Power that flies with you."
	"quest.517EE7AE88BA56A3.quest_desc": [
		"Saw and press an iron sheet into an engine assembly, then craft it between an iron sheet and a blast furnace: a portable engine. It burns furnace fuel for 32 RPM and 2,048 stress, and a blaze cake superheats it to 64. Feed it like a burner. This is what turns your propellers in the sky."
	]
	"task.55528E36493FAA45.title": "Assemble a propeller bearing"
	"quest.5008B58514B83369.title": "Forward!"
	"quest.5008B58514B83369.quest_subtitle": "Lift is nothing without thrust."
	"quest.5008B58514B83369.quest_desc": [
		"A propeller bearing (wooden slab, iron sheet, brass casing) spins the sails on its face: two at least, eight is better. Point it aft and drive it from your engine, with a clutch to hold it still while you assemble the ship. Faster shafts push longer: eight sails at 32 RPM top out near 4.5 m/s."
	]
	"task.17A3CDB3944AC8B2.title": "Grab and turn a steering wheel"
	"quest.55C23A2FFCCB8247.title": "Hard to Port"
	"quest.55C23A2FFCCB8247.quest_subtitle": "Two propellers, one wheel."
	"quest.55C23A2FFCCB8247.quest_desc": [
		"Put a propeller on each side, each with its own clutch at the helm: cut one and the ship turns. Or swing a rudder: a steering wheel (andesite casing, large cogwheel, shaft) turns a swivel bearing to an exact angle; set the bearing to stay assembled. Without thrust the wind pushes a ship along at walking pace."
	]
	"task.1D9251EA22F0182A.title": "Place a navigation table"
	"quest.4DFB46FEF1CE83BE.title": "Maiden Voyage"
	"quest.4DFB46FEF1CE83BE.quest_subtitle": "There and back again."
	"quest.4DFB46FEF1CE83BE.quest_desc": [
		"Fly your ship from your base to town and home again. A navigation table (brass sheet, precision mechanism, brass casing) at the helm gives a redstone signal towards its target, and the flight HUD shows speed, height and heading. Land with the keel flat: a ship only comes apart landed and level."
	]
	"task.1B890E3AD1AFDF79.title": "Lock two docking connectors together"
	"quest.45802F5A539BECDE.title": "Fill Her Up"
	"quest.45802F5A539BECDE.quest_subtitle": "A pier with a pump."
	"quest.45802F5A539BECDE.quest_desc": [
		"Docking connectors work in pairs: one in your ship's nose, one on a pier. Extend both and they line up and lock. While locked, items and fluids pass both ways, so funnels and pumps on the pier refuel the burners and load the hold. Never let the dock carry the ship: keep the keel down."
	]
	"quest.6168CEC945B4D9AB.title": "Diesel Power"
	"quest.6168CEC945B4D9AB.quest_subtitle": "Ninety-six revs and a lot of smoke."
	"quest.6168CEC945B4D9AB.quest_desc": [
		"A diesel engine (engine pistons, a brass block, a fluid tank, blackstone slabs, flint and steel) gives 96 RPM and 6,144 stress: three times a portable engine, and props that push to 13 m/s. Mix seed oil and ethanol into biodiesel, or pump crude oil and distil it. An analog lever throttles it."
	]
	"quest.25FA1B6FC0D10A9A.title": "Air Mail"
	"quest.25FA1B6FC0D10A9A.quest_subtitle": "The fastest roads are in the sky."
	"quest.25FA1B6FC0D10A9A.quest_desc": [
		"A ship with a hold is a business: chests on board carry the cargo and the dock loads them. Set down a delivery quests table (contraption diagram, compass, wooden slab) and take a job: fly the cargo to the drop, land it on time, collect the fee. The far drops pay best."
	]
	"chapter.6EFBA7C7F19E4A02.title": "Santa's Workshop"
	"chapter.6EFBA7C7F19E4A02.chapter_subtitle": [
		"The quota will not fill itself."
	]
	"quest.50F37896395DFCB1.title": "Santa's Toy Works"
	"quest.50F37896395DFCB1.quest_subtitle": "The Carousel turns, and toys come out."
	"quest.50F37896395DFCB1.quest_desc": [
		"Craft the controller (brass casing, paper, a cogwheel, a precision mechanism and a deployer) and ring a turning dial with Toy Works Casing: four Workshop Deployers on pedestals at its stops, an input port under the controller, a Drive Port and the Toy Chute at the back. Every team knows three toys. Make a Wooden Train."
		""
		"{image:cccasino:textures/gui/quest/mb_toy_works.png width:200 height:78 align:center}"
	]
	"quest.41023DBBCE14EC9D.title": "A New Design"
	"quest.41023DBBCE14EC9D.quest_subtitle": "Learn a toy nobody taught you."
	"quest.41023DBBCE14EC9D.quest_desc": [
		"The works knows the Wooden Train, the Spinning Top and the Rocking Horse. Every other toy needs its blueprint, and Santa's Shop sells each one once a season. Use a blueprint on your controller and your whole team learns that toy for good. JEI shows every toy's steps on the Toy Works page."
	]
	"quest.3C332E5EB1726584.title": "Eight Hands"
	"quest.3C332E5EB1726584.quest_subtitle": "Every face of the toy."
	"quest.3C332E5EB1726584.quest_desc": [
		"Add a second deployer at each stop and the works reaches tier II: eight deployers, and a toy's steps can reach all four faces and the top. Learn the Clockwork Mouse and make one. Tier II toys are the ones worth sacking."
	]
	"quest.7F19373A1F5858BC.title": "Fired in the Kiln"
	"quest.7F19373A1F5858BC.quest_subtitle": "Paint that sets hard."
	"quest.7F19373A1F5858BC.quest_desc": [
		"Seven tier II toys are fired in the paint kiln on their way out. The kiln is a lit blaze burner in a pit one block under the floor, beneath the back of the ring by the outlet. Without heat those toys stop half painted. Learn the Toy Telescope and fire one."
	]
	"reward.4A1954435A3DD9B6.title": "Fireworks!"
	"quest.70E21DF1177F2B61.title": "Master Toymaker"
	"quest.70E21DF1177F2B61.quest_subtitle": "Superheated, eight hands, one snow globe."
	"quest.70E21DF1177F2B61.quest_desc": [
		"The snow globe is the hardest toy in the works: every tier II deployer, and a kiln kept superheated on blaze cake. Learn it, make it, and wrap it for someone who has been very good this year."
	]
	"quest.6E5B88DF0CAA50F1.title": "The Gift Wrapper"
	"quest.6E5B88DF0CAA50F1.quest_subtitle": "One stroke, one present."
	"quest.6E5B88DF0CAA50F1.quest_desc": [
		"Mix paper and dye for wrapping paper. The Gift Wrapper presses a toy and a sheet into a present, one stroke at a time, on Create power. Run a belt from your Toy Chute through it and wrap a toy in red."
	]
	"quest.755A24D22F84FF75.title": "Ribbon and Tag"
	"quest.755A24D22F84FF75.quest_subtitle": "The finishing touch."
	"quest.755A24D22F84FF75.quest_desc": [
		"A deployer holding a ribbon spool ties a bow on a passing present, and one holding a gift tag adds the tag. Neither is needed for the quota, but a dressed present is the proper way to send a toy to Santa."
	]
	"quest.072E0AC2B3CCAE09.title": "Santa's Sack Hoist"
	"quest.072E0AC2B3CCAE09.quest_subtitle": "Thirty-two presents, one sealed sack."
	"quest.072E0AC2B3CCAE09.quest_desc": [
		"Feed presents to the Sack Hoist and give it an empty sack. At 32 presents the winch seals the sack and sets it down. A sack counts toward the server's Toy Quota once it is delivered to Santa's Sleigh in the North Pole village, and the delivery is credited to whoever placed the hoist. Fill your first sack."
		""
		"{image:cccasino:textures/gui/quest/mb_sack_hoist.png width:200 height:78 align:center}"
	]
	"quest.11CE1B69A84314E4.title": "Christmas Spirit"
	"quest.11CE1B69A84314E4.quest_subtitle": "What rises from a full sack."
	"quest.11CE1B69A84314E4.quest_desc": [
		"Each sealed sack gives off eight Spirit Wisps. A heated mixer turns a wisp, an eggnog and a glowstone dust into 250 mB of Christmas Spirit, a glowing fluid. Pipe it to a Spout and fill an empty bucket: four batches a bucket. The Yuletide Forge drinks it by pipe or by the bucket."
	]
	"quest.4530F11F5D045B0C.title": "A Little Luck"
	"quest.4530F11F5D045B0C.quest_subtitle": "Lucky Tonic."
	"quest.4530F11F5D045B0C.quest_desc": [
		"Spirit has a second use. A heated mixer turns 250 mB of it, a rabbit's foot, a golden carrot, a sprig of mistletoe and two sugar into Lucky Tonic, and a spout bottles it. Drink it at the casino: for five minutes your cards and reels come out better more often. About one bottle in ten comes out Fine."
	]
	"quest.5AECE8411290B83C.title": "A Bowl for the Table"
	"quest.5AECE8411290B83C.quest_subtitle": "The Lucky Punch Bowl."
	"quest.5AECE8411290B83C.quest_desc": [
		"Brass sheets, glass and a brass casing on Mechanical Crafters make a punch bowl. Set it on the casino floor and run a spout over it: it holds four cups of Lucky Tonic, and anyone takes a cup with an empty hand. A round of luck for the whole table, as long as the bowl lasts."
	]
	"quest.0239AA5C1C21389A.title": "A Finer Vintage"
	"quest.0239AA5C1C21389A.quest_subtitle": "Ten minutes instead of five."
	"quest.0239AA5C1C21389A.quest_desc": [
		"Any brew can be made Fine: deploy a leaf of gold (a saw cuts a gold sheet into four) and spout a second 250 mB of Spirit into it. A Fine bottle lasts ten minutes. Brews never stack: a stronger one replaces a weaker, and the same brew only starts its timer again."
	]
	"quest.380B0EB54C77A0AA.title": "Mistletoe Elixir"
	"quest.380B0EB54C77A0AA.quest_subtitle": "Luck II."
	"quest.380B0EB54C77A0AA.quest_desc": [
		"Twice the luck takes a superheated mixer: 500 mB of Lucky Tonic, 250 mB of Spirit, an emerald, a glistering melon slice and a phantom membrane. On a bottle, a spout fills it, a deployer seals it with a gold sheet and a press closes it. Villagers, a melon line and a sleepless night or two."
	]
	"quest.06E9B8A86768F020.title": "The Star Draught"
	"quest.06E9B8A86768F020.quest_subtitle": "Luck III."
	"quest.06E9B8A86768F020.quest_desc": [
		"The strongest luck there is: 500 mB of Elixir, 500 mB of Spirit, an echo shard and a totem of undying in a superheated mixer make Starlight. Bottle it, then set it in a vial of gold sheets, glowstone and a precision mechanism on Mechanical Crafters. An Ancient City and a raid stand between you and it."
	]
	"quest.34852C3F2E93CB6F.title": "Load Santa's Sleigh"
	"quest.34852C3F2E93CB6F.quest_subtitle": "Every sack counts toward the quota."
	"quest.34852C3F2E93CB6F.quest_desc": [
		"Santa's Sleigh waits in the North Pole village. Land a sealed sack in its bed by hand, belt, funnel, chute or Mechanical Arm: each one adds 32 presents to the Toy Quota, credited to whoever placed its hoist. A Display Link on the sleigh reads the quota. Its tail, behind the loading hatch, is where a belt hands in."
	]
	"chapter.174BDD9E16EB501B.title": "The Yuletide Forge"
	"chapter.174BDD9E16EB501B.chapter_subtitle": [
		"Netherite, blaze cake and Christmas Spirit."
	]
	"quest.6C3C3D57A6C68162.title": "The Forge Hall"
	"quest.6C3C3D57A6C68162.quest_subtitle": "Ten by eight, seven courses high."
	"quest.6C3C3D57A6C68162.quest_desc": [
		"The forge is a fixed build: a ring ten by eight on Forge Plinth, walls of Forge Glazing and Casing, a roof and a chimney, a blaze burner, the hammer and twelve forge blocks inside. The controller and hammer take netherite; the Spirit Quench a bucket of Spirit. A Spirit Inlet in a wall pipes it in; JEI's \"Yuletide Forge: Structure\" page shows every block."
		""
		"{image:cccasino:textures/gui/quest/mb_forge.png width:200 height:78 align:center}"
	]
	"quest.47402B7D7EF3FBC7.title": "Forged in Spirit"
	"quest.47402B7D7EF3FBC7.quest_subtitle": "A Yuletide Sword."
	"quest.47402B7D7EF3FBC7.quest_desc": [
		"A job takes the ladder (wooden, stone, iron, gold and diamond swords), a netherite sword, two festive foods, a glaze and 750 mB of Spirit. The burner melts while lit and strikes only superheated on blaze cake. Sweet berries glaze it Crimson, blue ice Frost, a spruce sapling Evergreen."
	]
	"quest.55C1D1C3A3B18513.title": "Hat and Boots"
	"quest.55C1D1C3A3B18513.quest_subtitle": "750 mB of Spirit each."
	"quest.55C1D1C3A3B18513.quest_desc": [
		"Armour takes leather, iron, gold and diamond in its ladder, then the netherite piece, food, a glaze and 750 mB of Christmas Spirit apiece. Any colourway will do, and they need not match. Forge a Yuletide Helmet and Yuletide Boots."
	]
	"reward.41675B840DA204CB.title": "Fireworks!"
	"quest.5A4EACBF22DA2BA2.title": "Dressed for the Season"
	"quest.5A4EACBF22DA2BA2.quest_subtitle": "The whole Yuletide set."
	"quest.5A4EACBF22DA2BA2.quest_desc": [
		"The chestplate and leggings take a full bucket of Spirit each and the most food. With the helmet, boots and sword that is the full Yuletide set. The early spirits will be balanced around it and a Yuletide blade: in netherite you would barely scrape through."
	]
	"quest.25122BFA1F675A1F.title": "Tools of the Trade"
	"quest.25122BFA1F675A1F.quest_subtitle": "Pickaxe, axe and shovel."
	"quest.25122BFA1F675A1F.quest_desc": [
		"The forge makes the tools the same way as the sword: the five vanilla tiers in the ladder, the netherite tool, food, a glaze and Spirit (750 mB for the pickaxe and axe, 500 mB for the shovel and the hoe). Optional, but they last."
	]
	"quest.3A98AD37449E571A.title": "The Star of Saint Nicholas"
	"quest.3A98AD37449E571A.quest_subtitle": "Two turns round the line."
	"quest.3A98AD37449E571A.quest_desc": [
		"A golden sheet rides a sequenced-assembly line twice: a Spout fills 250 mB of Spirit, Deployers add a diamond and glowstone dust, then a Press sets them. Half a bucket a Star. Every Saint Nick piece takes a Star in its netherite slot, so build the line to keep running."
	]
	"quest.14A9E0EFBED3AA0F.title": "Hung with Care"
	"quest.14A9E0EFBED3AA0F.quest_subtitle": "Hearth, mantel and pedestal."
	"quest.14A9E0EFBED3AA0F.quest_desc": [
		"Saint Nick pieces are forged at a fireplace, not under the hammer. Make its three inside parts: the Forge Hearth (precision mechanisms, a blaze burner, gold, bricks and a sturdy sheet), the Stocking Mantel (brass sheets, a bell and red, green and light blue wool) and the Display Pedestal (red wool, gold and a depot)."
	]
	"quest.6DB79AD649883567.title": "The Chimney Bay"
	"quest.6DB79AD649883567.quest_subtitle": "Tier II, and a stack with a star."
	"quest.6DB79AD649883567.quest_desc": [
		"Add the Flue Damper (copper casing, an electron tube, a fluid valve, a precision mechanism) and the Chimney Crown (copper sheets, gold), then build the bay three blocks wide on the hall's right in the same plinth, glazing and roofing. JEI's \"Tier II: Chimney bay\" page shows each block. Stand by the forge once it reaches tier II."
	]
	"quest.49B4631A81F12ED1.title": "The North Star"
	"quest.49B4631A81F12ED1.quest_subtitle": "One sword from three."
	"quest.49B4631A81F12ED1.quest_desc": [
		"A Saint Nick piece is forged at the Chimney bay's hearth. It takes the same Yuletide piece in all three colourways (Crimson, Frost and Evergreen) and a Star, with one more food and 500 mB more Spirit than the Yuletide job, and no glaze. Forge a Saint Nick Sword."
	]
	"quest.1D626E22795A9E7F.title": "Mitre and Runners"
	"quest.1D626E22795A9E7F.quest_subtitle": "Six Yuletide pieces, two Stars."
	"quest.1D626E22795A9E7F.quest_desc": [
		"The Mitre of Saint Nicholas takes a Yuletide Helmet in each colourway and a Star; the Sleigh-Runner Boots take three Yuletide Boots and a Star. Forge Crimson, Frost and Evergreen of each first, so plan the glazes. Forge both."
	]
	"reward.774D3D3425727363.title": "Fireworks!"
	"quest.3204CFABB0699CF7.title": "Saint Nick"
	"quest.3204CFABB0699CF7.quest_subtitle": "The whole set, and the bells."
	"quest.3204CFABB0699CF7.quest_desc": [
		"Add the Sleigh Harness and the Coat Skirt. Wear all four for sleigh bells (a little speed), presents from hostile mobs, a frost aura that slows them, and regeneration near a fire or candle. The late spirits will be balanced around this set and a Saint Nick blade."
	]
	"quest.3165110C41E45804.title": "Saint Nick's Tools"
	"quest.3165110C41E45804.quest_subtitle": "Three tools from nine."
	"quest.3165110C41E45804.quest_desc": [
		"Each Saint Nick tool takes its Yuletide tool in all three colourways and a Star: Rudolph the pickaxe, the Sleigh Runner axe, the Tree and Gift shovel (and the Crozier, a hoe). Optional, and very much a showpiece."
	]
	"chapter.4F4482EF7FA6359B.title": "Free the Spirits"
	"chapter.4F4482EF7FA6359B.chapter_subtitle": [
		"Eight villains. Eight spirits. Coming soon."
	]
	"task.7CF675F36E1AF890.title": "Defeat Krampus (coming soon)"
	"reward.0B0197D3B2A59DDC.title": "Fireworks!"
	"quest.1B3551E21608CAFF.title": "Krampus (coming soon)"
	"quest.1B3551E21608CAFF.quest_subtitle": "Free the Spirit of Giving. Not built yet."
	"quest.1B3551E21608CAFF.quest_desc": [
		"Krampus stalks the forest roads with a sack and a chain, and inside the sack is the Spirit of Giving. Free it and every gift on the server feels a little more generous. Coming soon: this fight is not in the game yet."
	]
	"task.6426510A37227A0F.title": "Defeat The Frost Wyrm (coming soon)"
	"reward.3689235AFB4CE88B.title": "Fireworks!"
	"quest.08B432324938E9BE.title": "The Frost Wyrm (coming soon)"
	"quest.08B432324938E9BE.quest_subtitle": "Free the Spirit of Warmth. Not built yet."
	"quest.08B432324938E9BE.quest_desc": [
		"The Frost Wyrm coils under the glacier and breathes a cold no fire can touch. It swallowed the Spirit of Warmth. Bring it back and the long nights soften. Coming soon: this fight is not in the game yet."
	]
	"task.4EC1E97BECAC8CFC.title": "Defeat The Rat King (coming soon)"
	"reward.45A7941B99B8A95B.title": "Fireworks!"
	"quest.51E3D867E3B037D3.title": "The Rat King (coming soon)"
	"quest.51E3D867E3B037D3.quest_subtitle": "Free the Spirit of Plenty. Not built yet."
	"quest.51E3D867E3B037D3.quest_desc": [
		"Under the village granaries the Rat King hoards every crumb the Food Drive collects, and the Spirit of Plenty with them. Clear the tunnels and the pantries fill again. Coming soon: this fight is not in the game yet."
	]
	"task.1E2C61EE5BCD76D4.title": "Defeat The Humbug (coming soon)"
	"reward.183B428A4CF6F5D1.title": "Fireworks!"
	"quest.0558CFF730B2BAC8.title": "The Humbug (coming soon)"
	"quest.0558CFF730B2BAC8.quest_subtitle": "Free the Spirit of Cheer. Not built yet."
	"quest.0558CFF730B2BAC8.quest_desc": [
		"The Humbug hates laughter, lights and music, and he keeps the Spirit of Cheer in a locked box. His raiders strike undefended bases. Stop him and the whole server cheers up. Coming soon: this fight is not in the game yet."
	]
	"task.62E337A8AE5923E7.title": "Defeat The Coal Golem (coming soon)"
	"reward.1E25186A7DE98F57.title": "Fireworks!"
	"quest.51867C53CE8E5F9F.title": "The Coal Golem (coming soon)"
	"quest.51867C53CE8E5F9F.quest_subtitle": "Free the Spirit of Industry. Not built yet."
	"quest.51867C53CE8E5F9F.quest_desc": [
		"Built from every lump of coal ever left in a stocking, the Coal Golem guards the Spirit of Industry deep in the mines. Free it and the factories of the North Pole run hotter. Coming soon: this fight is not in the game yet."
	]
	"task.68FE2628E1B01A8E.title": "Defeat The Ice Queen (coming soon)"
	"reward.424DC8C3F545C37B.title": "Fireworks!"
	"quest.4139CFBEDA31B46D.title": "The Ice Queen (coming soon)"
	"quest.4139CFBEDA31B46D.quest_subtitle": "Free the Spirit of Wonder. Not built yet."
	"quest.4139CFBEDA31B46D.quest_desc": [
		"The Ice Queen froze the Spirit of Wonder into the heart of her palace, and the snow stopped sparkling. Thaw her court and the aurora returns to the northern sky. Coming soon: this fight is not in the game yet."
	]
	"task.5188EB1A6AF3D981.title": "Defeat The Yeti Matriarch (coming soon)"
	"reward.0CA920CD4F92A98F.title": "Fireworks!"
	"quest.342A3841E27A20B7.title": "The Yeti Matriarch (coming soon)"
	"quest.342A3841E27A20B7.quest_subtitle": "Free the Spirit of Home. Not built yet."
	"quest.342A3841E27A20B7.quest_desc": [
		"High in the peaks the Yeti Matriarch guards her den, and with it the Spirit of Home. Win it back and every hearth in the village burns brighter. Coming soon: this fight is not in the game yet."
	]
	"task.749EE7B374FC23CF.title": "Defeat The Wraith of Christmas Yet to Come (coming soon)"
	"reward.46E525A02A6F5565.title": "Fireworks!"
	"quest.46F09AC114FE8C01.title": "The Wraith of Christmas Yet to Come (coming soon)"
	"quest.46F09AC114FE8C01.quest_subtitle": "Free the Spirit of Christmas. Not built yet."
	"quest.46F09AC114FE8C01.quest_desc": [
		"The last villain waits for Christmas Eve. The Wraith holds the Spirit of Christmas itself, and if it is not freed, Santa's sleigh stays grounded. Every spirit freed before then makes the fight fairer. Coming soon: this fight is not in the game yet."
	]
	"chapter.080155EC6799C4F9.title": "Advent"
	"chapter.080155EC6799C4F9.chapter_subtitle": [
		"One door a day, 1 December to Christmas Day."
	]
	"task.00C75271B9FB6595.title": "Open on 1 December"
	"quest.559A0A926A5C76D6.title": "Door 1: The First Door"
	"quest.559A0A926A5C76D6.quest_subtitle": "Opens on 1 December."
	"quest.559A0A926A5C76D6.quest_desc": [
		"December is here, and the calendar on the village square has twenty-four little doors. One opens each real day. Behind each is something new for the North Pole: a game, a recipe, a job, a surprise. Come back tomorrow."
	]
	"task.0EC0C529961D5C67.title": "Open on 2 December"
	"quest.643EFD15A683DE79.title": "Door 2: Hot Chocolate Weather"
	"quest.643EFD15A683DE79.quest_subtitle": "Opens on 2 December."
	"quest.643EFD15A683DE79.quest_desc": [
		"The snow is deep enough to lose a boot in. Today's door comes with a warm drink and a reminder: the Food Drive needs every pot and kettle in the North Pole working until Christmas Eve."
	]
	"task.2781A07A9AD092BD.title": "Open on 3 December"
	"quest.6117F82E57D103AE.title": "Door 3: Carols in the Square"
	"quest.6117F82E57D103AE.quest_subtitle": "Opens on 3 December."
	"quest.6117F82E57D103AE.quest_desc": [
		"The carollers have started their rounds. They sing in the square every evening, and they sing louder for anyone who brings cocoa. Open the door and see what they left behind."
	]
	"task.3F2C25E3401ECA4F.title": "Open on 4 December"
	"quest.7EC4ACA863D244B3.title": "Door 4: Fresh Snowfall"
	"quest.7EC4ACA863D244B3.quest_subtitle": "Opens on 4 December."
	"quest.7EC4ACA863D244B3.quest_desc": [
		"Overnight the whole valley turned white again. The rails need clearing, the airship pads need sweeping, and somebody built a snowman on the casino steps. Door four is open."
	]
	"task.70064B16A3765DDD.title": "Open on 5 December"
	"quest.5C453FA0E7118CF6.title": "Door 5: Letters to Santa"
	"quest.5C453FA0E7118CF6.quest_subtitle": "Opens on 5 December."
	"quest.5C453FA0E7118CF6.quest_desc": [
		"The post office is full of letters, and every one asks for something only a factory can make. The toy quota just got bigger. Today's door is a little help from the sorting room."
	]
	"task.58454223DD2D542A.title": "Open on 6 December"
	"quest.50CB6B9C3B3C0E0B.title": "Door 6: St Nicholas' Day"
	"quest.50CB6B9C3B3C0E0B.quest_subtitle": "Opens on 6 December."
	"quest.50CB6B9C3B3C0E0B.quest_desc": [
		"On the sixth, St Nicholas leaves coins in the shoes of good children. At the North Pole he leaves chips. Check your boots, then check the square: today is the first big door of the season."
	]
	"task.793D3C7E81DBDE1E.title": "Open on 7 December"
	"quest.0CEE61D6D3AA2A05.title": "Door 7: The Toy Lines Wake"
	"quest.0CEE61D6D3AA2A05.quest_subtitle": "Opens on 7 December."
	"quest.0CEE61D6D3AA2A05.quest_desc": [
		"The workshop's machines are warming up for the big push. The quieter the line, the more Santa worries. Open door seven, then go and listen to your own factory run."
	]
	"task.333DC0C0CFCFB05E.title": "Open on 8 December"
	"quest.68DDD5F8E67EEFE7.title": "Door 8: Wrapping Night"
	"quest.68DDD5F8E67EEFE7.quest_subtitle": "Opens on 8 December."
	"quest.68DDD5F8E67EEFE7.quest_desc": [
		"Paper, ribbon and a steady hand: the elves wrap until dawn tonight, and anyone who joins them gets fed. Door eight brings something for the wrapping table."
	]
	"task.063BB6B4BC2951FF.title": "Open on 9 December"
	"quest.254C82B4215037C3.title": "Door 9: Gingerbread Village"
	"quest.254C82B4215037C3.quest_subtitle": "Opens on 9 December."
	"quest.254C82B4215037C3.quest_desc": [
		"Somebody started a gingerbread village on the bakery counter, and now everyone wants a house in it. Today's door is sweet, and so is whatever is baking in the square."
	]
	"task.3BF5572BB9A90BFF.title": "Open on 10 December"
	"quest.70DD7ED8683832A2.title": "Door 10: The Long Night"
	"quest.70DD7ED8683832A2.quest_subtitle": "Opens on 10 December."
	"quest.70DD7ED8683832A2.quest_desc": [
		"The nights are long now, and getting longer. Lights on every roof, lanterns on every path: a lit village is a village that is still fighting for Christmas. Open door ten."
	]
	"task.5A9E07CA06D294E0.title": "Open on 11 December"
	"quest.1351273906BC99C5.title": "Door 11: Market Day"
	"quest.1351273906BC99C5.quest_subtitle": "Opens on 11 December."
	"quest.1351273906BC99C5.quest_desc": [
		"The stalls are out and the prices are chalked up. Bring what you made and sell it for chips, or spend them on something you have had your eye on. Door eleven opens with the market."
	]
	"task.0B04A616930EAB44.title": "Open on 12 December"
	"quest.5E21CC1EC1F94F0C.title": "Door 12: Halfway There"
	"quest.5E21CC1EC1F94F0C.quest_subtitle": "Opens on 12 December."
	"quest.5E21CC1EC1F94F0C.quest_desc": [
		"Twelve doors open, twelve to go. Think back to the first week: no machines, no rails, an empty pantry. Look how far the server has come since. Today's door is a pat on the back for everyone."
	]
	"task.223DF289026668FD.title": "Open on 13 December"
	"quest.710D30666A60EB8E.title": "Door 13: St Lucia's Day"
	"quest.710D30666A60EB8E.quest_subtitle": "Opens on 13 December."
	"quest.710D30666A60EB8E.quest_desc": [
		"In the north, the thirteenth is St Lucia's Day: candles in the darkest week of the year. Light one in your window, then open the second big door of December."
	]
	"task.69D3344083368B15.title": "Open on 14 December"
	"quest.61E07A7EB42F77A4.title": "Door 14: The Big Freeze"
	"quest.61E07A7EB42F77A4.quest_subtitle": "Opens on 14 December."
	"quest.61E07A7EB42F77A4.quest_desc": [
		"The lakes have frozen solid enough to skate on, and the ice roads are open. A good day to visit a neighbour you have not seen in a while. Door fourteen is waiting."
	]
	"task.282674E78C4A0BB2.title": "Open on 15 December"
	"quest.6830C950C8B62411.title": "Door 15: Overtime at the Workshop"
	"quest.6830C950C8B62411.quest_subtitle": "Opens on 15 December."
	"quest.6830C950C8B62411.quest_desc": [
		"Ten days to Christmas and the toy quota is not filling itself. The elves are on double shifts. Whatever your factory makes, today is a good day to make more of it."
	]
	"task.46FD582D6C822620.title": "Open on 16 December"
	"quest.40CD899D51BC691A.title": "Door 16: Cookie Exchange"
	"quest.40CD899D51BC691A.quest_subtitle": "Opens on 16 December."
	"quest.40CD899D51BC691A.quest_desc": [
		"Bring a tray of cookies, leave with somebody else's. Every kitchen in the North Pole has its own recipe, and everyone thinks theirs is best. Open door sixteen and taste the difference."
	]
	"task.35E44C9F7B5DEEC0.title": "Open on 17 December"
	"quest.7FF9353F13451D5A.title": "Door 17: Airship Post"
	"quest.7FF9353F13451D5A.quest_subtitle": "Opens on 17 December."
	"quest.7FF9353F13451D5A.quest_desc": [
		"The sleigh is not the only thing in the sky this month. Parcels go by airship now, and the pilots are busy from dawn to dusk. Today's door came by air, and it landed right on time."
	]
	"task.58558C8284B164E3.title": "Open on 18 December"
	"quest.6B17DB9528845566.title": "Door 18: Garlands and Greenery"
	"quest.6B17DB9528845566.quest_subtitle": "Opens on 18 December."
	"quest.6B17DB9528845566.quest_desc": [
		"One week out. Every hall gets a wreath, every beam a garland, every tree its star. Walk the village tonight and see whose street glows brightest. Door eighteen has something to hang."
	]
	"task.3F5CEE4D43F58386.title": "Open on 19 December"
	"quest.379231FC650BFB02.title": "Door 19: Casino Night"
	"quest.379231FC650BFB02.quest_subtitle": "Opens on 19 December."
	"quest.379231FC650BFB02.quest_desc": [
		"The tables are full and the dealers are in their best waistcoats. Play a hand, spin the wheel, or just watch the high rollers sweat. Door nineteen comes with a little something for the felt."
	]
	"task.4B8CF6DEB84656FE.title": "Open on 20 December"
	"quest.1F07A20ABA429C4D.title": "Door 20: The Last Sunday"
	"quest.1F07A20ABA429C4D.quest_subtitle": "Opens on 20 December."
	"quest.1F07A20ABA429C4D.quest_desc": [
		"The last Sunday before Christmas, and the third big door of the season. Look around the square: the North Pole is brighter, fuller and warmer than it was on the first."
	]
	"task.21E82AC5AE6B2C6B.title": "Open on 21 December"
	"quest.7FECDA9331F253DF.title": "Door 21: Midwinter"
	"quest.7FECDA9331F253DF.quest_subtitle": "Opens on 21 December."
	"quest.7FECDA9331F253DF.quest_desc": [
		"The shortest day of the year. From tomorrow the light comes back, a minute at a time. The old stories say this is when the spirits are easiest to reach. Open door twenty-one."
	]
	"task.23A258C8E4C95564.title": "Open on 22 December"
	"quest.33FA66DBB7BAF932.title": "Door 22: Loading the Sleigh"
	"quest.33FA66DBB7BAF932.quest_subtitle": "Opens on 22 December."
	"quest.33FA66DBB7BAF932.quest_desc": [
		"Santa's sleigh is being loaded, and every sack delivered to it counts toward the toy quota. The elves check the count twice a day now, and so does Santa. Door twenty-two is for the loaders."
	]
	"task.75C8D060369C4899.title": "Open on 23 December"
	"quest.7ED1D431533DF59B.title": "Door 23: The Night Before the Night Before"
	"quest.7ED1D431533DF59B.quest_subtitle": "Opens on 23 December."
	"quest.7ED1D431533DF59B.quest_desc": [
		"Tomorrow is Christmas Eve. Finish the last batch, wrap the last present, polish the last table. Door twenty-three is a deep breath before the big night."
	]
	"task.6425B063B2B75E7C.title": "Open on 24 December"
	"quest.4BE66736FDCB6B11.title": "Door 24: Christmas Eve"
	"quest.4BE66736FDCB6B11.quest_subtitle": "Opens on 24 December."
	"quest.4BE66736FDCB6B11.quest_desc": [
		"The last night of Advent. Tonight the village tree is lit, the quota is counted and the North Pole holds its breath for the sleigh. Whatever happens, everyone here is proud of what you built. One more door tomorrow."
	]
	"task.0A0AB9C5483EB8E8.title": "Open on 25 December"
	"quest.06B5F84F56739786.title": "Door 25: Christmas Day"
	"quest.06B5F84F56739786.quest_subtitle": "Opens on 25 December."
	"quest.06B5F84F56739786.quest_desc": [
		"Merry Christmas. The sleigh has flown, the stockings are full and the whole North Pole is at the long table. Thank you for every machine, meal and present you made this season. This door is the last, and it is for you."
	]
	"chapter.07A864A645B84CC0.title": "Field Guide"
	"chapter.07A864A645B84CC0.chapter_subtitle": [
		"Optional: more of what the pack can do."
	]
	"quest.49CD427ACD3F27B2.title": "The Schematicannon"
	"quest.49CD427ACD3F27B2.quest_subtitle": "Build it once, print it forever."
	"quest.49CD427ACD3F27B2.quest_desc": [
		"A schematicannon fires blocks into place from a saved schematic. Copy a friend's perfect fry line, or print the same station at every stop on your railway."
	]
	"quest.35FB736AB6004EBB.title": "Farming on Rails"
	"quest.35FB736AB6004EBB.quest_subtitle": "Let the machine do the harvest."
	"quest.35FB736AB6004EBB.quest_desc": [
		"A harvester on a moving contraption reaps ripe crops and leaves the plant to grow back. Sweep a row of wheat with one and your bakery will never run short of flour."
	]
	"quest.2A7E0185CF5DA58A.title": "Soul Fire"
	"quest.2A7E0185CF5DA58A.quest_subtitle": "One trip to the Nether, then never again."
	"quest.2A7E0185CF5DA58A.quest_desc": [
		"An encased fan blowing through soul fire haunts what passes it: sand turns to soul sand, cobblestone to blackstone. Washing soul sand gives quartz, about one for every two blocks. Bring home a single soul sand and the soul fire keeps itself going."
	]
	"quest.0582BE6035D4D467.title": "Diving Gear"
	"quest.0582BE6035D4D467.quest_subtitle": "Pressurised air, by the tank."
	"quest.0582BE6035D4D467.quest_desc": [
		"A copper backtank stores air for diving and powers Create's hand tools. With a diving helmet you can work under the frozen lakes as long as the tank lasts."
	]
	"quest.738FCE3772DDEDFF.title": "Spud Gun"
	"quest.738FCE3772DDEDFF.quest_subtitle": "Ammunition grows in the garden."
	"quest.738FCE3772DDEDFF.quest_desc": [
		"The potato cannon fires whatever you load into its backtank-fed barrel. Potatoes, carrots, sweet berries, even a pie. It is built on a crafter grid with a precision mechanism, and it is a lot of fun to aim."
	]
	"quest.7B6A31AFEA6FA2A2.title": "Somewhere to Put It All"
	"quest.7B6A31AFEA6FA2A2.quest_subtitle": "Chests are for amateurs."
	"quest.7B6A31AFEA6FA2A2.quest_desc": [
		"Item vaults link into one huge store that funnels and arms can reach from any side. Every factory you build from here on wants one at the start of the line and one at the end."
	]
	"quest.2EB7A654E81D70A3.title": "Speed Control"
	"quest.2EB7A654E81D70A3.quest_subtitle": "Exactly as fast as you need."
	"quest.2EB7A654E81D70A3.quest_desc": [
		"A rotation speed controller sets the speed of everything after it, to the RPM. Slow the deal at a casino table, speed up a fryer, or stop a line overstressing the whole network."
	]
	"quest.7E799DBCBA9F6520.title": "Going Up"
	"quest.7E799DBCBA9F6520.quest_subtitle": "A lift with floors."
	"quest.7E799DBCBA9F6520.quest_desc": [
		"An elevator pulley runs a car between floors that you call with contacts. Build a proper lift in your workshop and nobody will climb stairs again. Your knees will thank you by Christmas."
	]
	"quest.3BBA298AFC171715.title": "Extendo Grip"
	"quest.3BBA298AFC171715.quest_subtitle": "Reach for it."
	"quest.3BBA298AFC171715.quest_desc": [
		"An extendo grip lets you reach much further, which matters when you are building a factory three storeys up. Feed it from a backtank and it never wears out."
	]
	"quest.22C6FD4AB848F277.title": "Patience and Cheese"
	"quest.22C6FD4AB848F277.quest_subtitle": "Good things come to those who wait."
	"quest.22C6FD4AB848F277.quest_desc": [
		"Curdle milk, press the curds into a wheel and let it age: young, then aged, and the older it is the more it is worth. Check the wheel in JEI before you wax it. The best cheese on the server will be the oldest."
	]
	"quest.038921FFDFD25064.title": "The Tea Room"
	"quest.038921FFDFD25064.quest_subtitle": "Green and black, by the pot."
	"quest.038921FFDFD25064.quest_desc": [
		"Brew tea leaves into green and black tea and bottle them, or roast coffee beans. A quiet tea room is the best place in the North Pole to sit down and plan your next factory over a warm cup."
	]
	"quest.3351CA8AC3970DC2.title": "Dress the Casino"
	"quest.3351CA8AC3970DC2.quest_subtitle": "Casings for a proper casino floor."
	"quest.3351CA8AC3970DC2.quest_desc": [
		"Andesite casing and red dye make Casino Casing. Add green dye for Holly Casing, a brass sheet for Gilded Casing, red and white dye for a Candy-Stripe Pillar, or a glass pane for Window Casing. They connect like Create's own casings: dress the walls round your tables."
	]
	"reward_table.2F987FFAF3252378.title": "Christmas Stocking"
	"reward_table.7A49BBDFE5202D38.title": "Wrapped Gift"
	"reward_table.3848E9948122780E.title": "Big Present"
	"reward_table.3888701C8FA57640.title": "Santa's Sack"
	"reward_table.575BD0F5305D8B39.title": "Advent Box"
}
