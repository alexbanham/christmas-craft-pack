// ### THE MOD REQUIRES A RESTART OF THE GAME TO APPLY CHANGES ###
// Christmas Craft 2026 (integration-spec-worldgen-mobs-2026-10-27 section 4.1).
// spreadFactor 1 = vanilla spacing (mod default 2 would double all spacing, snowy villages included).
// idBasedSalt false keeps vanilla salts so seed-scan results stay valid; overlap risk accepted.
{
  "spreadFactor": 1,

  "idBasedSalt": false,

  "customSpreadFactors": [
    { "structure": "minecraft:mansion", "factor": 1 },
    // 0 = disabled: duplicates of YUNG's Better Mineshafts. Hostile structures are on (Alex, 2026-11-02).
    { "structure": "repurposed_structures:mineshafts_overworld", "factor": 0 },
    { "structure": "repurposed_structures:mineshafts_ocean", "factor": 0 },
  ]
}
